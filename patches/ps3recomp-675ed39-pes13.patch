+/* sys_prx_register_library(u32 lib_addr): libsre registers itself with lv2 so
+ * the process can use the SRE heap/mempool API. Nothing in lv2 depends on the
+ * registration here -- the library image is already in guest memory and its
+ * exports are reached through the OPD it printed -- so record it and succeed.
+ * Called three times at this title's startup; the alternative was the generic
+ * unresolved path, which answers CELL_OK without consuming the argument and
+ * looks identical until something reads the registration back. */
+s32 sys_prx_register_library(u32 lib_addr)
+{
+    printf("[sysPrxForUser] sys_prx_register_library(0x%08X)\n", lib_addr);
+    return CELL_OK;
+}
+
+/* ---------------------------------------------------------------------------
+ * Memory pools (sys_mempool_*)
+ *
+ * libsre carves a fixed-block pool out of memory the caller already owns:
+ *
+ *     sys_mempool_create(&pool, addr, size, block_size)
+ *
+ * and asks how much of it is still free. A pool owns no memory of its own -- it
+ * is a header over the caller's buffer -- so the honest model is the block
+ * arithmetic, and the caller's own allocator does the handing out. Only these
+ * two entries are imported by this title (create and get_count); the allocate /
+ * free entries would be the place to grow if a title needed them.
+ * -----------------------------------------------------------------------*/
+typedef struct {
+    int in_use;
+    u32 addr, size, block_size, blocks;
+    u32 alloc_blocks;
+} sys_mempool_t;
+
+static sys_mempool_t s_mempools[16];
+
+s32 sys_mempool_create(u32* pool, u32 addr, u32 size, u32 block_size)
+{
+    u32* hp = (u32*)yz_g2h(pool);
+    if (!hp || !block_size || !size) return CELL_EINVAL;
+
+    for (int i = 0; i < 16; i++) {
+        if (s_mempools[i].in_use) continue;
+        s_mempools[i].in_use = 1;
+        s_mempools[i].addr = addr;
+        s_mempools[i].size = size;
+        s_mempools[i].block_size = block_size;
+        s_mempools[i].blocks = size / block_size;
+        s_mempools[i].alloc_blocks = 0;
+        *hp = (u32)(0x50000100u + (u32)i);   /* opaque pool handle */
+        printf("[sysPrxForUser] sys_mempool_create(addr=0x%08X size=0x%X "
+               "block=0x%X) -> pool=0x%08X blocks=%u\n",
+               addr, size, block_size, *hp, s_mempools[i].blocks);
+        return CELL_OK;
+    }
+    return CELL_EINVAL;
+}
+
+s32 sys_mempool_get_count(u32 pool, u32* count)
+{
+    u32* hp = (u32*)yz_g2h(count);
+    if (!hp) return CELL_EINVAL;
+    const int i = (int)(pool - 0x50000100u);
+    if (i < 0 || i >= 16 || !s_mempools[i].in_use) return CELL_EINVAL;
+    *hp = s_mempools[i].blocks - s_mempools[i].alloc_blocks;
+    return CELL_OK;
+}
