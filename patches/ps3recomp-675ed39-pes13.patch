diff --git a/libs/video/rsx_vp_decompiler.c b/libs/video/rsx_vp_decompiler.c
index b9ed32be..4cb7679b 100644
--- a/libs/video/rsx_vp_decompiler.c
+++ b/libs/video/rsx_vp_decompiler.c
@@ -214,6 +214,40 @@ static u32 sca_source_use(u32 op, int* exact)
     }
 }
 
+int rsx_vp_analyze_constants(const u8* ucode, u32 max_bytes,
+                             rsx_vp_const_usage* usage)
+{
+    if (!usage) return -1;
+    usage->lo = 1; usage->hi = 0; usage->relative = 0; usage->valid = 0;
+    if (!ucode) return -1;
+    u32 off = 0;
+    int instrs = 0;
+    while (off + 16 <= max_bytes) {
+        const u32 d1 = rd_le(ucode + off + 4);
+        const u32 d2 = rd_le(ucode + off + 8);
+        const u32 d3 = rd_le(ucode + off + 12);
+        off += 16;
+        instrs++;
+        /* The same fields emit_src's callers decode. */
+        const u32 const_src = (d1 >> 12) & 0x3FF;
+        const int index_const = (d3 >> 1) & 1;
+        const u32 src[3] = {
+            ((d2 >> 23) & 0x1FF) | ((d1 & 0xFF) << 9),
+            (d2 >> 6) & 0x1FFFF,
+            ((d3 >> 21) & 0x7FF) | ((d2 & 0x3F) << 11),
+        };
+        for (int i = 0; i < 3; i++) {
+            if ((src[i] & 3u) != 3u) continue;
+            if (index_const) { usage->relative = 1; continue; }
+            const u32 c = const_src & 511u;
+            if (usage->lo > usage->hi) { usage->lo = usage->hi = c; }
+            else { if (c < usage->lo) usage->lo = c; if (c > usage->hi) usage->hi = c; }
+        }
+        if (d3 & 1u) { usage->valid = 1; return instrs; }
+    }
+    return -1;
+}
+
 int rsx_vp_analyze_inputs(const u8* ucode, u32 max_bytes,
                           rsx_vp_input_analysis* analysis)
 {
diff --git a/libs/video/rsx_vp_decompiler.h b/libs/video/rsx_vp_decompiler.h
index ecc53fce..d42038ca 100644
--- a/libs/video/rsx_vp_decompiler.h
+++ b/libs/video/rsx_vp_decompiler.h
@@ -34,6 +34,20 @@ typedef struct rsx_vp_input_analysis {
  * is zero and input_mask is 0xFFFF when an unsupported opcode/control-flow
  * construct makes the result unsafe to narrow.  Returns the instruction
  * count, or -1 for invalid/non-terminated input. */
+/* Which vp_c[] rows a decompiled program can read. Every constant-typed
+ * source field of every instruction up to the end flag counts, used by its
+ * opcode or not -- the decompiler emits all three, so this is a superset of
+ * what the shader reads. `relative` means some read is vp_c[(N + aX) & 511]
+ * and any row may be read. `valid` is 0 when no end flag was found; treat the
+ * whole block as read then. lo > hi means no constant is read. */
+typedef struct rsx_vp_const_usage {
+    u32 lo, hi;
+    int relative;
+    int valid;
+} rsx_vp_const_usage;
+int rsx_vp_analyze_constants(const u8* ucode, u32 max_bytes,
+                             rsx_vp_const_usage* usage);
+
 int rsx_vp_analyze_inputs(const u8* ucode, u32 max_bytes,
                           rsx_vp_input_analysis* analysis);
 
