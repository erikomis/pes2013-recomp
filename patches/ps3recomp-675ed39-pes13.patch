+/* PS3_AUDIO_MUTE=1 (or PS3_MUTE=1): silence at the device, nothing else changes
+ * -- the title still has a working cellAudio, paced as before. PS3_AUDIO_VOLUME=
+ * 0..100: the host output's level, applied to what is queued. */
+static float audio_host_gain(void)
+{
+    static float gain = -1.0f;
+    if (gain < 0.0f) {
+        const char* m = getenv("PS3_AUDIO_MUTE");
+        const char* m2 = getenv("PS3_MUTE");
+        const char* v = getenv("PS3_AUDIO_VOLUME");
+        gain = 1.0f;
+        if (v && *v) {
+            const int pct = atoi(v);
+            gain = pct <= 0 ? 0.0f : pct >= 100 ? 1.0f : (float)pct / 100.0f;
+        }
+        if ((m && atoi(m)) || (m2 && atoi(m2))) gain = 0.0f;
+    }
+    return gain;
