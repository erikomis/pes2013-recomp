+/* The draw engine's present pass with PS3_AA=fxaa and PS3_SHARPEN, and the
+ * picture filters (PS3_VIBRANCE, PS3_CONTRAST, PS3_LUT_PRESET and
+ * PS3_LUT_STRENGTH, PS3_VIGNETTE, PS3_GRAIN): what each one does to a small
+ * synthetic display buffer, that with everything off the present is still an
+ * exact copy, and that the filters at their neutral values are one too;
+ * and PS3_UPSCALE=metalfx up to a larger drawable.
+ * Needs a Metal device; no window.
  *
  *   clang -fobjc-arc -I include -I libs/video libs/video/tests/test_metal_present_post.m \
  *     -Wl,-dead_strip -framework Metal -framework Cocoa -framework QuartzCore \
@@ -110,6 +114,178 @@ int main(void)
         present(in, out, 1, 1.0f);
         assert(!memcmp(out[row + 5], in[row + 5], 4) && !memcmp(out[row + 26], in[row + 26], 4));
 
+        /* ---- the picture filters ---- */
+        /* Read from an empty environment: all off, the plain present. */
+        unsetenv("PS3_VIBRANCE"); unsetenv("PS3_CONTRAST"); unsetenv("PS3_VIGNETTE");
+        unsetenv("PS3_GRAIN"); unsetenv("PS3_LUT"); unsetenv("PS3_LUT_PRESET");
+        unsetenv("PS3_LUT_STRENGTH");
+        s_eng_post_read = 0;
+        eng_post_options();
+        assert(s_eng_post_read && !s_eng_post_on && !s_eng_lut);
+        for (int y = 0; y < H; y++)
+            for (int x = 0; x < W; x++) {
+                px4* q = &in[y * W + x];       /* BGRA: a dull, a vivid and a grey third */
+                if (x < 11)      { (*q)[0] = 100; (*q)[1] = 120; (*q)[2] = 140; }
+                else if (x < 22) { (*q)[0] = 20;  (*q)[1] = 40;  (*q)[2] = 230; }
+                else             { (*q)[0] = (*q)[1] = (*q)[2] = (unsigned char)(y * 8); }
+                (*q)[3] = 0xC0;
+            }
+        present(in, out, 0, 0.0f);
+        assert(s_eng_blit_pso_post == 0 && !memcmp(in, out, sizeof in));
+
+        /* The post shader at neutral values (it is chosen only when a filter
+         * is on, but must then not touch what is not asked for). */
+        s_eng_post_on = 1;
+        present(in, out, 0, 0.0f);
+        assert(s_eng_blit_pso_post == 1);
+        for (int i = 0; i < W * H; i++)
+            for (int k = 0; k < 4; k++) assert(abs((int)out[i][k] - (int)in[i][k]) <= 1);
+
+        /* Contrast: away from mid-grey; grey stays grey; alpha kept. */
+        s_eng_contrast = 1.5f;
+        present(in, out, 0, 0.0f);
+        { const unsigned char* dark = out[2 * W + 26];   /* y = 2: 16 */
+          const unsigned char* lite = out[30 * W + 26];  /* y = 30: 240 */
+          printf("contrast 1.5: 16 -> %u, 240 -> %u\n", dark[0], lite[0]);
+          assert(dark[0] < 8 && lite[0] == 255 && dark[0] == dark[1] && dark[1] == dark[2]);
+          assert(out[0][3] == 0xC0); }
+        s_eng_contrast = 1.0f;
+
+        /* Vibrance: the dull colour spreads further from its grey than the
+         * vivid one does (relative to their own spread); negative mutes. */
+        s_eng_vibrance = 1.0f;
+        present(in, out, 0, 0.0f);
+        { const int dull_in = in[5][2] - in[5][0], dull_out = out[5][2] - out[5][0];
+          const int viv_in = in[15][2] - in[15][0], viv_out = out[15][2] - out[15][0];
+          printf("vibrance 1: dull spread %d -> %d, vivid %d -> %d\n", dull_in, dull_out, viv_in, viv_out);
+          assert(dull_out > dull_in && (double)dull_out / dull_in > (double)viv_out / viv_in); }
+        s_eng_vibrance = -1.0f;
+        present(in, out, 0, 0.0f);
+        assert(out[5][2] - out[5][0] < in[5][2] - in[5][0]);
+        s_eng_vibrance = 0.0f;
+
+        /* Vignette: corners darker, the centre as it was. */
+        s_eng_vignette = 1.0f;
+        present(in, out, 0, 0.0f);
+        printf("vignette 1: corner %u (was %u), centre %u (was %u)\n",
+               out[31 * W + 31][0], in[31 * W + 31][0], out[16 * W + 16][0], in[16 * W + 16][0]);
+        assert(out[31 * W + 31][0] < in[31 * W + 31][0]);
+        assert(abs((int)out[16 * W + 16][0] - (int)in[16 * W + 16][0]) <= 1);
+        s_eng_vignette = 0.0f;
