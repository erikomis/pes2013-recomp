+/* Public helper: take one event out of a queue by id, without blocking.
+ *
+ * The SPU side of sys_spu_thread_bind_queue has no way to call into the event
+ * layer: it asks for "the next event of the queue I bound" by writing that
+ * queue's spuq token to its outbound mailbox. lv2 answers by moving the event's
+ * four words into the inbound mailbox, so the kernel needs a non-blocking pop
+ * that does not disturb a PPU receiver parked on the same queue. */
+int sys_event_queue_pop_by_id(uint32_t queue_id, sys_event_t* out)
+{
+    if (queue_id == 0 || queue_id > SYS_EVENT_QUEUE_MAX || !out) return -1;
+    sys_event_queue_info* q = &g_sys_event_queues[queue_id - 1];
+    if (!q->active || q->capacity <= 0) return -1;
+
+    int got = -1;
+#ifdef _WIN32
+    EnterCriticalSection(&q->lock);
+#else
+    pthread_mutex_lock(&q->lock);
+#endif
+    if (q->count > 0) {
+        *out = q->buffer[q->head];
+        q->head = (q->head + 1) % q->capacity;
+        q->count--;
+        got = 0;
+    }
+#ifdef _WIN32
+    LeaveCriticalSection(&q->lock);
+#else
+    pthread_mutex_unlock(&q->lock);
+#endif
+    return got;
+}
+
+/* Public helper: resolve an event queue by its ipc_key (as registered at * sys_event_queue_create). Returns the queue_id (1-based) or 0 if none. Used by
  * cellAudio to route the audio-period notify event to the game's queue. */
 uint32_t sys_event_find_queue_by_key(uint64_t key)
 {
