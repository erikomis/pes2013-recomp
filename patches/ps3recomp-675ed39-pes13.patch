+/* The CPU and the SPUs read main memory with no transfer the engine would see,
+ * and PES 2013's far players are kits baked into a 128x128 target there. */
+static void main_target(u32 offset, u32 w, u32 h)
+{
+    m(M_CONTEXT_DMA_COLOR_A, DMA_MAIN);
+    m(M_SURFACE_CLIP_H, w << 16);
+    m(M_SURFACE_CLIP_V, h << 16);
+    m(M_COLOR_A_PITCH, w * 4u);
+    m(M_COLOR_A_OFFSET, offset);
+}
+
+static void local_target(void)
+{
+    m(M_CONTEXT_DMA_COLOR_A, DMA_LOCAL);
+    m(M_SURFACE_CLIP_H, 256u << 16);
+    m(M_SURFACE_CLIP_V, 256u << 16);
+    m(M_COLOR_A_PITCH, 1024u);
+    m(M_COLOR_A_OFFSET, 0x40000u);
+}
+
+/* A title with many targets must not lose the later ones: PES 2013 fills a table of
+ * 64 before its match load, whose far kits start at the 60th target and went missing
+ * with no message. */
+static void test_many_surfaces(void)
+{
+    printf("-- many surfaces\n");
+    engine_up();
+    const u32 n = 200u, off = 0x100000u;
+    u32 stored = 0;
+    for (u32 i = 0; i < n; i++) {
+        main_target(off + i * 0x1000u, 16u, 16u);
+        vm_base[off + i * 0x1000u] = 0;
+        m(M_CLEAR_BUFFERS, 0xF0u);
+        local_target();
+        m(M_CLEAR_BUFFERS, 0xF0u);
+        stored += vm_base[off + i * 0x1000u] == 0x44;
+    }
+    CHECK(stored == n, "every one of %u targets is rendered and stored (%u)", n, stored);
+    engine_down();
+}
+
+static void test_main_target_write_back(void)
+{
+    printf("-- main memory target write-back\n");
+    const u32 off = 0x100000u, last = 127u * 512u + 127u * 4u;
+    u8* first = vm_base + off, *end = vm_base + off + last;
+
+    engine_up();
+    main_target(off, 128u, 128u);
+    memset(first, 0, 128u * 512u);
+    m(M_CLEAR_BUFFERS, 0xF0u);
+    CHECK(first[0] == 0, "a target still being rendered stays on the GPU");
+    local_target();
+    m(M_CLEAR_BUFFERS, 0xF0u);
+    CHECK(first[0] == 0x44 && first[1] == 0x11 && first[2] == 0x22 && first[3] == 0x33 &&
+          end[0] == 0x44 && end[3] == 0x33,
+          "leaving a small main memory target stores all of it as A8R8G8B8");
+
+    memset(first, 0, 128u * 512u);
+    m(M_CLEAR_BUFFERS, 0xF0u);
