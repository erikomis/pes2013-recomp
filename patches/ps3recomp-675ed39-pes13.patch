+    main_target(off, 128u, 128u);
+    m(M_CLEAR_BUFFERS, 0xF0u);
+    m(0x1D70u, 1u);
+    CHECK(first[0] == 0x44 && end[3] == 0x33, "a fence stores the target still bound");
+    engine_down();
+
+    engine_up();
+    const u32 big_off = 0x200000u;
+    main_target(big_off, 1024u, 1024u);
+    m(M_CLEAR_BUFFERS, 0xF0u);
+    vm_base[big_off] = 0;
+    local_target();
+    m(M_CLEAR_BUFFERS, 0xF0u);
