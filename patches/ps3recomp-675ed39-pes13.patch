+        const int v = eng_hexval((unsigned char)name[i]);
+        if (v < 0) return 0;
+        k = (k << 4) | (u64)v;
+    }
+    if (eng_hexval((unsigned char)name[16]) >= 0) return 0;
+    const size_t n = strlen(name);
+    if (n < 20 || name[n - 4] != '.' || (name[n - 3] | 32) != 'p' || (name[n - 2] | 32) != 'n' ||
+        (name[n - 1] | 32) != 'g') return 0;
+    return k ? k : 1u;
