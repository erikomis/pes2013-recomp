+        rsx_fp_decompile(prog, sizeof(prog), CTRL_32BIT, hlsl, sizeof(hlsl));
+        check("wpos_scaled", hlsl, "((_rsx_wpos(input.position)).xyzw)");
+        check("wpos_scaled_helper", hlsl, "#define _rsx_wpos(p) float4((p).x * 0.5, (p).y * 0.5, (p).zw)");
+        rsx_fp_set_wpos_scale(1.5f);
+        rsx_fp_decompile(prog, sizeof(prog), CTRL_32BIT, hlsl, sizeof(hlsl));
+        check("wpos_scaled_1_5", hlsl, "(p).x * 0.666666667");
+        rsx_fp_set_wpos_scale(0.0f);                      /* nonsense: back to 1 */
+        rsx_fp_decompile(prog, sizeof(prog), CTRL_32BIT, hlsl, sizeof(hlsl));
+        check_true("wpos_back_to_native", !strcmp(hlsl, base));
+    }
+
+    /* Register fields are 6 bits, so a program can name r63 and h63. Files of 48
+     * made such a program fail to compile, and its draw was dropped: PES 2013's
+     * players were missing from the pitch. */
+    {
+        u8 prog[16];
+        put_word(prog + 0, OPC(0x01) | OUTMASK_ALL | OUTHALF | OUTREG(63) | END); /* MOV h63, r63 */
+        put_word(prog + 4, T_TEMP | REG(63) | SWZ_IDENT | EXEC_ALWAYS);
+        put_word(prog + 8, 0);
+        put_word(prog + 12, 0);
+        rsx_fp_decompile(prog, sizeof(prog), CTRL_16BIT, hlsl, sizeof(hlsl));
+        check("regs_named_h63",   hlsl, "h[63]");
+        check("regs_named_r63",   hlsl, "r[63]");
+        check("regs_declared_64", hlsl, "float4 r[64]; float4 h[64];");
+        check("regs_zeroed_64",   hlsl, "_i < 64;");
+    }
+
     printf("\n===========================================\n");
     printf("Results: %d passed, %d failed\n", g_pass, g_fail);
     return g_fail ? 1 : 0;
