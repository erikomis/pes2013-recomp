 }
+/* A store is the same thread of checks in vm_write*: an address the bitmap says an SPU
+ * has reserved, or a watch being armed (vm_store_inline_ok), takes the full path. Without
+ * this every guest store is a call, and PES 2013's game threads spent about a fifth of
+ * their time getting into and out of it. */
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern int vm_store_inline_ok;
+extern unsigned char g_spu_coh_bitmap[];
+#ifdef __cplusplus
+}
+#endif
+static inline int vm_store_inl_ok(uint32_t ea, uint32_t n)
+{
+    return __builtin_expect(vm_store_inline_ok, 1) && vm_inl_ok(ea, n) &&
+           !((g_spu_coh_bitmap[ea >> 10] >> ((ea >> 7) & 7u)) & 1u);
+}
+static inline void vm_write8_inl(uint64_t a, uint8_t v)
+{
+    const uint32_t ea = (uint32_t)a;
+    if (vm_store_inl_ok(ea, 1)) { __atomic_store_n(vm_base + ea, v, __ATOMIC_RELAXED); return; }
+    vm_write8(a, v);
+}
+static inline void vm_write16_inl(uint64_t a, uint16_t v)
+{
+    const uint32_t ea = (uint32_t)a;
+    if (vm_store_inl_ok(ea, 2)) {
+        v = __builtin_bswap16(v);
+        if (!(ea & 1u)) __atomic_store_n((uint16_t*)(vm_base + ea), v, __ATOMIC_RELAXED);
+        else memcpy(vm_base + ea, &v, 2);
+        return; }
+    vm_write16(a, v);
+}
+static inline void vm_write32_inl(uint64_t a, uint32_t v)
+{
+    const uint32_t ea = (uint32_t)a;
+    if (vm_store_inl_ok(ea, 4)) {
+        v = __builtin_bswap32(v);
+        if (!(ea & 3u)) __atomic_store_n((uint32_t*)(vm_base + ea), v, __ATOMIC_RELAXED);
+        else memcpy(vm_base + ea, &v, 4);
+        return; }
+    vm_write32(a, v);
+}
+static inline void vm_write64_inl(uint64_t a, uint64_t v)
+{
+    const uint32_t ea = (uint32_t)a;
+    if (vm_store_inl_ok(ea, 8)) {
+        v = __builtin_bswap64(v);
+        if (!(ea & 7u)) __atomic_store_n((uint64_t*)(vm_base + ea), v, __ATOMIC_RELAXED);
+        else memcpy(vm_base + ea, &v, 8);
+        return; }
+    vm_write64(a, v);
+}
 #ifndef PPU_NO_INLINE_LOADS
+#define vm_write8(a, v)  vm_write8_inl((a), (v))
+#define vm_write16(a, v) vm_write16_inl((a), (v))
+#define vm_write32(a, v) vm_write32_inl((a), (v))
+#define vm_write64(a, v) vm_write64_inl((a), (v))
 #define vm_read8(a)  vm_read8_inl(a)
 #define vm_read16(a) vm_read16_inl(a)
 #define vm_read32(a) vm_read32_inl(a)
