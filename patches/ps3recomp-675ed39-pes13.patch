+/* A LINEAR texture keeps its pitch at every level, and a level starts after the
+ * previous level's rows at that pitch. PES 2013's kit is 1024x512, pitch 4096,
+ * with level 1 right after 512 rows of 4096 bytes. Read at a pitch of its own, it
+ * came out in stripes of black and the kit's other colours. */
+static void test_mip_chain_keeps_pitch(void)
+{
+    rsx_tex_level lv[RSX_MAX_TEXTURE_LEVELS];
+    u32 n = rsx_texture_mip_chain(FMT_A8R8G8B8 | FMT_LN, 1024, 512, 3, 4096, lv);
+    CHECK_EQ(n, 3);
+    CHECK_EQ(lv[1].tl.row_bytes, 4096);
+    CHECK_EQ(lv[1].tl.dst_row_bytes, 512u * 4u);
+    CHECK_EQ(lv[1].offset, 4096u * 512u);
+    CHECK_EQ(lv[2].tl.row_bytes, 4096);
+    CHECK_EQ(lv[2].offset, 4096u * (512u + 256u));
+
+    /* No pitch: each level is packed at its own width. */
+    n = rsx_texture_mip_chain(FMT_A8R8G8B8 | FMT_LN, 1024, 512, 2, 0, lv);
+    CHECK_EQ(lv[1].tl.row_bytes, 512u * 4u);
+
+    /* Swizzled: no rows to space out. */
+    n = rsx_texture_mip_chain(FMT_A8R8G8B8, 64, 64, 2, 4096, lv);
+    CHECK_EQ(lv[1].tl.row_bytes, 32u * 4u);
+    (void)n;
+}
