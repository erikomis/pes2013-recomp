+static uint32_t g_heap = 0x00400000u;
+static u32 host_alloc(u32 size, u32 align)
+{
+    if (!align) align = 4;
+    g_heap = (g_heap + align - 1u) & ~(align - 1u);
+    u32 r = g_heap;
+    g_heap += size;
+    return r;
+}
+static void gw32(uint32_t ea, uint32_t v)
+{
+    uint8_t* p = vm_base + ea;
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+static void host_w32(u32 ea, u32 v) { gw32(ea, v); }
+
+static int fails;
+static void check(int ok, const char* what)
+{
+    printf("[%s] %s\n", ok ? "PASS" : "FAIL", what);
+    fails += !ok;
+}
+
+/* An incrementing method header: count words, subchannel subch. */
+static u32 put_cmd(u32 io, u32 subch, u32 method, u32 count, const u32* args)
+{
+    gw32(IO_ADDR + io, (count << 18) | (subch << 13) | method);
+    for (u32 i = 0; i < count; i++) gw32(IO_ADDR + io + 4 + i * 4, args[i]);
+    return io + 4 + count * 4;
+}
+static u32 put_probe(u32 io, u32 arg) { return put_cmd(io, 7, 0x0B00u, 1, &arg); }
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    const uint32_t vm_size = ppu_hle_inject_base + 0x10000u;
+    vm_base = (uint8_t*)calloc(1, vm_size);
+    if (!vm_base) { puts("FAIL: guest VM alloc"); return 1; }
+    ppu_vm_size = vm_size;
+
+    u32 ctx_out = host_alloc(4, 4);
+    (void)cellGcmSetupContext(ctx_out, CMD_SIZE, IO_SIZE, IO_ADDR, host_alloc, host_w32);
+    const uint32_t ctrl = (uint32_t)(uintptr_t)cellGcmGetControlRegister();
+    const u32 ctx = vm_read32(ctx_out);
+    const u32 begin = vm_read32(ctx + 0), end = vm_read32(ctx + 4);
+    check(begin && end > begin, "the title has a ring");
+
+    /* A queued command, and the title's current at the end of the ring. */
+    u32 io = put_probe(0, 0);
+    s_fifo_getoff = 0;
+    vm_write32(ctrl + 4, 0);
+    vm_write32(ctrl + 0, io);
+    vm_write32(ctx + 8, end);
+    cellGcm_rsx_process_fifo();
+    check(vm_read32(ctx + 8) == end, "the first pass at end leaves the ring alone");
+
+    /* Still there, but it moved: the title is working, not stuck. */
+    usleep(300000);
+    vm_write32(ctx + 8, end + 4);
+    cellGcm_rsx_process_fifo();
+    check(vm_read32(ctx + 8) == end + 4, "a current that moved restarts the wait");
+
+    /* Back inside the ring: the callback ran, nothing is remembered. */
+    vm_write32(ctx + 8, begin + 16);
+    cellGcm_rsx_process_fifo();
+    usleep(300000);
+    vm_write32(ctx + 8, end);
+    cellGcm_rsx_process_fifo();
+    check(vm_read32(ctx + 8) == end, "leaving end and coming back starts over");
+
+    /* Unmoved past the wait: wedged, and recovered. */
+    usleep(300000);
+    cellGcm_rsx_process_fifo();
+    check(vm_read32(ctx + 8) == begin, "a current stuck at end is recycled");
+
+    printf("[gcm_overrun] %s (%d failed)\n", fails ? "FAIL" : "PASS", fails);
+    free(vm_base);
+    return fails ? 1 : 0;
+}
diff --git a/libs/video/tests/test_metal_res_scale.m b/libs/video/tests/test_metal_res_scale.m
new file mode 100644
index 00000000..0e6411bc
--- /dev/null
+++ b/libs/video/tests/test_metal_res_scale.m
@@ -0,0 +1,163 @@
+/* PS3_RES_SCALE in the Metal backend: the knob's spellings; targets made at
+ * the scaled size (a seeded colour target filled nearest-neighbour); views and
+ * copies that inherit it; viewports and scissors that follow; and readbacks,
+ * colour and depth, that hand the guest its own pixels back (also at 1.5);
+ * a depth target read as A8R8G8B8 converted at the guest's size from the
+ * scaled depth; and the frame dump's box filter. Needs a Metal device; no
+ * window.
+ *
+ *   clang -fobjc-arc -I include -I libs/video libs/video/tests/test_metal_res_scale.m libs/video/rsx_texture_layout.c \
+ *     -Wl,-dead_strip -framework Metal -framework Cocoa -framework QuartzCore \
+ *     -o /tmp/test_metal_res_scale && /tmp/test_metal_res_scale
+ */
+#include "../rsx_metal_backend.m"
+#include <assert.h>
+#include <math.h>
+
+float cellAvconfExt_display_gamma(void) { return 1.0f; }
+
+static const char* fixture =
+"#include <metal_stdlib>\nusing namespace metal;\n"
+"struct V { float4 p [[position]]; };\n"
+"vertex V vs(uint i [[vertex_id]]) { float2 p[3]={float2(-1,-1),float2(3,-1),float2(-1,3)}; return {float4(p[i],0,1)}; }\n"
+/* every 2x2 block one value: the guest pixel it stands for */
+"struct D { float d [[depth(any)]]; }; fragment D fs(V v [[stage_in]]) {"
+" return {0.125f + floor(v.p.x * 0.5f) * 0.125f + floor(v.p.y * 0.5f) * 0.0625f}; }\n";
+static float expected(u32 x, u32 y) { return .125f + x * .125f + y * .0625f; }
+
+int main(void)
+{
+    @autoreleasepool {
+        /* the knob */
+        assert(res_scale_from(NULL) == 1.0f && res_scale_from("") == 1.0f);
+        assert(res_scale_from("2") == 2.0f && res_scale_from("1.5") == 1.5f && res_scale_from("2x") == 2.0f);
+        assert(res_scale_from("1080p") == 1.5f && res_scale_from("1440P") == 2.0f && res_scale_from("4k") == 3.0f);
+        assert(res_scale_from("720p") == 1.0f && res_scale_from("1.6") == 1.5f);   /* quarter steps */
+        assert(res_scale_from("5") == 1.0f && res_scale_from("0.5") == 1.0f && res_scale_from("big") == 1.0f);
+
+        s_dev = MTLCreateSystemDefaultDevice();
+        if (!s_dev) { puts("test_metal_res_scale: no Metal device, skipped"); return 0; }
+        s_queue = [s_dev newCommandQueue];
+        s_res_scale = 2.0f;
+        assert(res_px(4) == 8 && res_px(3) == 6 && res_px(0) == 0);
+        assert(eng_init(NULL, 4, 3) == 0);
+
+        /* a seeded colour target: 8x6, each guest pixel a 2x2 block */
+        u8 seed[4 * 3 * 4];
+        for (u32 i = 0; i < 12; i++) { seed[i * 4] = (u8)(i * 20); seed[i * 4 + 1] = (u8)(255 - i); seed[i * 4 + 2] = 7; seed[i * 4 + 3] = 255; }
+        const u32 color = eng_color_target_create(NULL, RSX_BE_FMT_R8G8B8A8, 4, 3, seed, 16);
+        assert(color && eng_obj_is_scaled(color));
+        assert([eng_obj(color) width] == 8 && [eng_obj(color) height] == 6);
+        u8 big[8 * 6 * 4];
+        [eng_obj(color) getBytes:big bytesPerRow:32 fromRegion:MTLRegionMake2D(0, 0, 8, 6) mipmapLevel:0];
+        assert(!memcmp(big + (3 * 8 + 5) * 4, seed + (1 * 4 + 2) * 4, 4));   /* (5,3) -> guest (2,1) */
+        /* read back at the guest's size: the seed, exactly */
+        u8 back[4 * 3 * 4];
+        memset(back, 0xCD, sizeof back);
+        eng_readback(NULL, color, 0, 0, 4, 3, back, 16);
+        assert(!memcmp(back, seed, sizeof seed));
+        u8 roi[2 * 2 * 4 + 4];
+        memset(roi, 0xCD, sizeof roi);
+        eng_readback(NULL, color, 1, 1, 2, 2, roi, 12);                     /* padded rows */
+        assert(!memcmp(roi, seed + (1 * 4 + 1) * 4, 8) && !memcmp(roi + 12, seed + (2 * 4 + 1) * 4, 8));
+        assert(roi[8] == 0xCD);
+
+        /* a view and a copy of it are scaled too; a guest texture is not */
+        const u32 view = eng_surface_view(NULL, color, 0xAAE4, 0x85);
+        assert(view && eng_obj_is_scaled(view));
+        const u32 copy = eng_color_snapshot(NULL, color);
+        assert(copy && eng_obj_is_scaled(copy) && [eng_obj(copy) width] == 8);
+        const u32 tex = eng_texture_create(NULL, RSX_BE_FMT_R8G8B8A8, 4, 3, 1, 1, 0xAAE4, 0x85);
+        assert(tex && !eng_obj_is_scaled(tex) && [eng_obj(tex) width] == 4);
+
+        /* viewport and scissor follow the targets */
+        eng_set_viewport(NULL, 0.0f, 0.0f, 4.0f, 3.0f);
+        assert(s_eng_pending.vp[2] == 8.0f && s_eng_pending.vp[3] == 6.0f);
+        eng_set_scissor(NULL, 1, 1, 3, 2);
+        assert(s_eng_pending.sc[0] == 2 && s_eng_pending.sc[1] == 2 && s_eng_pending.sc[2] == 6 && s_eng_pending.sc[3] == 4);
+
+        /* depth: 8x6, its snapshot 8x6, its readback the guest's 4x3 */
+        const u32 depth = eng_depth_target_create(NULL, 4, 3);
+        assert(depth && eng_obj_is_scaled(depth) && [eng_obj(depth) width] == 8);
+        NSError* err = nil;
+        id<MTLLibrary> lib = [s_dev newLibraryWithSource:@(fixture) options:nil error:&err];
+        assert(lib);
+        MTLRenderPipelineDescriptor* pd = [MTLRenderPipelineDescriptor new];
+        pd.vertexFunction = [lib newFunctionWithName:@"vs"];
+        pd.fragmentFunction = [lib newFunctionWithName:@"fs"];
+        pd.depthAttachmentPixelFormat = MTL_DEPTH_FORMAT; pd.stencilAttachmentPixelFormat = MTL_DEPTH_FORMAT;
+        id<MTLRenderPipelineState> pso = [s_dev newRenderPipelineStateWithDescriptor:pd error:&err];
+        assert(pso);
+        MTLRenderPassDescriptor* rp = [MTLRenderPassDescriptor renderPassDescriptor];
+        rp.depthAttachment.texture = eng_obj(depth); rp.depthAttachment.loadAction = MTLLoadActionClear;
+        rp.depthAttachment.clearDepth = 1; rp.depthAttachment.storeAction = MTLStoreActionStore;
+        rp.stencilAttachment.texture = eng_obj(depth); rp.stencilAttachment.loadAction = MTLLoadActionClear;
+        rp.stencilAttachment.storeAction = MTLStoreActionStore;
+        id<MTLCommandBuffer> cb = [s_queue commandBuffer];
+        id<MTLRenderCommandEncoder> e = [cb renderCommandEncoderWithDescriptor:rp];
+        MTLDepthStencilDescriptor* dsd = [MTLDepthStencilDescriptor new];
+        dsd.depthCompareFunction = MTLCompareFunctionAlways; dsd.depthWriteEnabled = YES;
+        [e setRenderPipelineState:pso]; [e setDepthStencilState:[s_dev newDepthStencilStateWithDescriptor:dsd]];
+        [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+        [e endEncoding]; [cb commit]; [cb waitUntilCompleted];
+        assert(cb.status == MTLCommandBufferStatusCompleted);
+        const u32 snap = eng_depth_snapshot(NULL, depth, 4, 3);
+        assert(snap && eng_obj_is_scaled(snap) && [eng_obj(snap) width] == 8 && [eng_obj(snap) height] == 6);
+        float dz[4 * 3 + 2];
+        for (int i = 0; i < 14; i++) dz[i] = -7.0f;
+        assert(eng_depth_readback(NULL, depth, 0, 0, 4, 3, dz, 16) == 0);
+        for (u32 y = 0; y < 3; y++)
+            for (u32 x = 0; x < 4; x++) assert(fabsf(dz[y * 4 + x] - expected(x, y)) < 1e-6f);
+        float droi[3] = { -9, -9, -9 };
+        assert(eng_depth_readback(NULL, depth, 2, 1, 2, 1, droi, 12) == 0);
+        assert(fabsf(droi[0] - expected(2, 1)) < 1e-6f && fabsf(droi[1] - expected(3, 1)) < 1e-6f && droi[2] == -9);
+        /* read as A8R8G8B8 (a shadow map the game samples as colour): the
+         * guest's 4x3, each texel the packed depth of its guest pixel */
+        const u32 argb = eng_depth_to_argb(NULL, depth, 0, 4, 3);
+        assert(argb && !eng_obj_is_scaled(argb) && [eng_obj(argb) width] == 4 && [eng_obj(argb) height] == 3);
+        eng_encode_and_commit(nil);
+        assert(!s_eng_encoding_failed);
+        { id<MTLBuffer> buf = [s_dev newBufferWithLength:4 * 4 * 3 options:MTLResourceStorageModeShared];
+          id<MTLCommandBuffer> c2 = [s_queue commandBuffer];
+          id<MTLBlitCommandEncoder> b = [c2 blitCommandEncoder];
+          [b copyFromTexture:eng_obj(argb) sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+                  sourceSize:MTLSizeMake(4, 3, 1) toBuffer:buf destinationOffset:0
+      destinationBytesPerRow:16 destinationBytesPerImage:48];
+          [b endEncoding]; [c2 commit]; [c2 waitUntilCompleted];
+          const u8* px = (const u8*)[buf contents];
+          for (u32 y = 0; y < 3; y++)
+              for (u32 x = 0; x < 4; x++) {
+                  const u32 v = (u32)fminf(expected(x, y) * 16777215.0f + 0.5f, 16777215.0f);
+                  const u8* q = px + (y * 4 + x) * 4;      /* R = [15:8], G = [7:0], A = [23:16] */
+                  assert(q[0] == ((v >> 8) & 0xFF) && q[1] == (v & 0xFF) && q[2] == 0 && q[3] == (v >> 16));
+              }
+        }
+
+        /* at 1.5 a seed goes up and comes back exactly */
+        s_res_scale = 1.5f;
+        assert(res_px(4) == 6 && res_px(3) == 5);
+        const u32 c15 = eng_color_target_create(NULL, RSX_BE_FMT_R8G8B8A8, 4, 3, seed, 16);
+        assert(c15 && eng_obj_is_scaled(c15) && [eng_obj(c15) width] == 6 && [eng_obj(c15) height] == 5);
+        memset(back, 0xCD, sizeof back);
+        eng_readback(NULL, c15, 0, 0, 4, 3, back, 16);
+        assert(!memcmp(back, seed, sizeof seed));
+        eng_set_scissor(NULL, 0, 0, 4, 3);
+        assert(s_eng_pending.sc[2] == 6 && s_eng_pending.sc[3] == 5);   /* to the target's edge */
+        s_res_scale = 2.0f;
+
+        /* the frame dump's box filter: each 2x2 block averaged */
+        { u8 img[4 * 2 * 4];
+          for (int i = 0; i < 8; i++) { img[i * 4] = (u8)(i * 10); img[i * 4 + 1] = 100; img[i * 4 + 2] = (u8)(i < 4 ? 0 : 255); img[i * 4 + 3] = 255; }
+          eng_res_box_down(img, 4, 2, 2, 1);
+          assert(img[0] == 25 && img[1] == 100 && img[2] == 128 && img[4] == 45); }
+
+        /* at 1, nothing is scaled */
+        s_res_scale = 1.0f;
+        const u32 plain = eng_color_target_create(NULL, RSX_BE_FMT_R8G8B8A8, 4, 3, seed, 16);
+        assert(plain && !eng_obj_is_scaled(plain) && [eng_obj(plain) width] == 4);
+        eng_set_viewport(NULL, 0.0f, 0.0f, 4.0f, 3.0f);
+        assert(s_eng_pending.vp[2] == 4.0f);
+        puts("test_metal_res_scale: ok");
+    }
+    return 0;
+}
diff --git a/libs/video/tests/test_nv308a_inline.c b/libs/video/tests/test_nv308a_inline.c
new file mode 100644
index 00000000..d272452a
--- /dev/null
+++ b/libs/video/tests/test_nv308a_inline.c
@@ -0,0 +1,83 @@
+/* NV308A image-from-CPU: cellGcmSetInlineTransfer sends up to 1792 words in one
+ * burst, as methods 0x0400..0x1FFC. Words past 0x07FC used to be dropped: everything
+ * after the first 1024 bytes of an upload stayed zero. PES 2013 uploads its fragment
+ * programs this way, and its characters drew with the end of their programs missing.
+ *
+ * clang -std=gnu17 -I include -I libs/video libs/video/tests/test_nv308a_inline.c -Wl,-dead_strip
+ *   -o /tmp/test_nv308a_inline && /tmp/test_nv308a_inline
+ *   (gcc: -ffunction-sections -fdata-sections -Wl,--gc-sections)
+ */
+#include "../cellGcmSys.c"
+#include <stdio.h>
+#include <stdlib.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+ps3_guest_caller_fn g_ps3_guest_caller;
+/* The rest of the walker's world: no graphics backend, no lifted program. */
+PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+u32 g_rsx_last_reference;
+void (*g_spu_put_hook)(uint32_t ea, uint32_t size);
+void rsx_raise_user_cmd(uint32_t arg) { (void)arg; }
+void ppu_dump_bctrl_ring(uint32_t n, const char* why) { (void)n; (void)why; }
+void ppu_dump_guest_stack(ppu_context* c, const char* why) { (void)c; (void)why; }
+void rsx_state_init(rsx_state* state) { (void)state; }
+int  rsx_process_method(rsx_state* state, u32 method, u32 data) { (void)state; (void)method; (void)data; return 0; }
+int  rsx_draw_engine_enabled(void) { return 1; }
+void rsx_draw_engine_method(u32 method, u32 arg) { (void)method; (void)arg; }
+void rsx_draw_engine_note_flip(u32 buffer_id) { (void)buffer_id; }
+/* guest_read is defined below: it plays the engine's part. */
+void rsx_draw_engine_guest_wrote(u32 l, u32 o, u32 p, u32 w, u32 h) { (void)l; (void)o; (void)p; (void)w; (void)h; }
+int  rsx_live_draw_enabled(void) { return 0; }
+void rsx_live_draw_method(u32 method, u32 arg) { (void)method; (void)arg; }
+int  rsx_live_draw_blit(u32 a, u32 b, u32 c, u32 d, u32 e, u32 f, u32 w, u32 h)
+{ (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)w; (void)h; return 0; }
+void rsx_live_draw_note_resolve(u32 a, u32 b, u32 c, u32 d) { (void)a; (void)b; (void)c; (void)d; }
+int  rsx_live_draw_resolve_blit(u32 a, u32 b, u32 c, u32 d, u32 e, u32 f, u32 g, u32 h,
+                                u32 i, u32 j, u32 k, u32 l)
+{ (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)g; (void)h; (void)i; (void)j; (void)k; (void)l; return 0; }
+
+
+#define LOCAL_BASE 0x00200000u      /* where "local memory" sits in the test's guest VM */
+#define DST_OFF    0x00100000u
+#define WORDS      1792u            /* NV308A's COLOR array: 0x0400..0x1FFC */
+
+void rsx_draw_engine_guest_read(u32 l, u32 o, u32 p, u32 w, u32 h)
+{ (void)l; (void)o; (void)p; (void)w; (void)h; }
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    const uint32_t vm_size = LOCAL_BASE + 0x00400000u;
+    vm_base = (uint8_t*)calloc(1, vm_size);
+    if (!vm_base) { puts("FAIL: guest VM alloc"); return 1; }
+    ppu_vm_size = vm_size;
+    ppu_hle_inject_base = vm_size;
+    s_config.localAddress = LOCAL_BASE;
+
+    gcm_2d_method(2, 0x0184, 0xFEED0000u);          /* NV3062: destination in local memory */
+    gcm_2d_method(2, 0x0304, 0x20002000u);          /* pitch 0x2000, both halves */
+    gcm_2d_method(2, 0x030C, DST_OFF);
+    gcm_2d_method(4, 0x0304, 0u);                   /* NV308A: point 0,0 */
+    gcm_2d_method(4, 0x0308, (1u << 16) | WORDS);
+    for (u32 i = 0; i < WORDS; i++)
+        gcm_2d_method(4, 0x0400 + i * 4u, 0xA5000000u | i);
+
+    int fails = 0;
+    for (u32 i = 0; i < WORDS; i++) {
+        const u32 got = vm_read32(LOCAL_BASE + DST_OFF + i * 4u);
+        if (got != (0xA5000000u | i)) {
+            if (fails++ < 3) printf("FAIL: word %u = 0x%08X\n", i, got);
+        }
+    }
+    printf("[nv308a_inline] %s (%d words wrong of %u)\n", fails ? "FAIL" : "PASS", fails, WORDS);
+    free(vm_base);
+    return fails ? 1 : 0;
+}
diff --git a/libs/video/tests/test_texture_packs.c b/libs/video/tests/test_texture_packs.c
new file mode 100644
index 00000000..c0b9a8d8
--- /dev/null
+++ b/libs/video/tests/test_texture_packs.c
@@ -0,0 +1,250 @@
+/*
+ * ps3recomp - texture packs (PS3_MODS, PS3_MODS_DIR, PS3_MODS_DUMP) in the
+ * draw engine: pack file names, the content key, pack order, the
+ * replacement's upload and mips, what is refused, the DXT decode the dump
+ * uses, and a guest texture replaced and dumped end to end through
+ * eng_texture_upload. A stub backend stands in for the image files.
+ *
+ *   clang -std=gnu17 -Wall -Wextra -Wno-unused-parameter -Wno-unused-function -I include -I libs/video \
+ *     -o /tmp/test_texture_packs libs/video/tests/test_texture_packs.c libs/video/rsx_dispatch.c \
+ *     libs/video/rsx_vertex_compact.c libs/video/rsx_texture_layout.c libs/video/rsx_vp_decompiler.c \
+ *     libs/video/rsx_fp_decompiler.c && /tmp/test_texture_packs
+ *
+ * The packs it makes go under $TMPDIR (else /tmp) and are removed at the end.
+ */
+#include "../rsx_draw_engine.c"
+#include <assert.h>
+#include <unistd.h>
+
+u8* vm_base;
+u32 ppu_vm_size;
+u32 cellGcmResolveLocated(int local, u32 offset) { return local ? (1u << 20) + offset : offset; }
+u32 cellGcmResolveIO(u32 offset) { return offset; }
+void cellGcm_replay_display_buffers_to_engine(void) {}
+
+/* ---- the stub backend ---------------------------------------------------- */
+static struct {
+    u32 next;
+    u32 created_w, created_h, created_mips, created_fmt, created_remap, created_rsx_fmt;
+    int n_create, n_upload, n_release;
+    u32 up_w[16], up_h[16], up_mip[16];
+    u8  first_texel[4];
+    int n_load, n_save;
+    char saved_path[700];
+    u32 saved_w, saved_h;
+    u8  saved_first[4];
+} st;
+
+static u32 stub_create(void* u, rsx_be_format fmt, u32 w, u32 h, u32 mips, u32 faces, u32 remap, u32 rsx_fmt)
+{
+    st.n_create++;
+    st.created_w = w; st.created_h = h; st.created_mips = mips; st.created_fmt = fmt;
+    st.created_remap = remap; st.created_rsx_fmt = rsx_fmt;
+    return ++st.next;
+}
+static void stub_upload(void* u, u32 t, u32 face, u32 mip, u32 w, u32 h, const void* src, u32 row, u32 rows)
+{
+    if (st.n_upload < 16) { st.up_w[st.n_upload] = w; st.up_h[st.n_upload] = h; st.up_mip[st.n_upload] = mip; }
+    if (mip == 0) memcpy(st.first_texel, src, 4);
+    st.n_upload++;
+}
+static void stub_release(void* u, u32 t) { st.n_release++; }
+/* An "image": its size is in the file name after an 'x' (…_16x8.png), every
+ * texel the same colour, 10 20 30 40. */
+static int stub_load(void* u, const char* path, u8** rgba, u32* w, u32* h)
+{
+    st.n_load++;
+    const char* p = strrchr(path, '_');
+    unsigned a = 0, b = 0;
+    if (!p || sscanf(p + 1, "%ux%u", &a, &b) != 2) return 0;
+    *rgba = (u8*)malloc((size_t)a * b * 4);
+    for (u32 i = 0; i < a * b; i++) { (*rgba)[i * 4] = 10; (*rgba)[i * 4 + 1] = 20; (*rgba)[i * 4 + 2] = 30; (*rgba)[i * 4 + 3] = 40; }
+    *w = a; *h = b;
+    return 1;
+}
+static int stub_save(void* u, const char* path, const u8* rgba, u32 w, u32 h, u32 row)
+{
+    st.n_save++;
+    snprintf(st.saved_path, sizeof st.saved_path, "%s", path);
+    st.saved_w = w; st.saved_h = h;
+    memcpy(st.saved_first, rgba, 4);
+    return 1;
+}
+static const rsx_draw_backend stub = {
+    .texture_create = stub_create, .texture_upload = stub_upload, .texture_release = stub_release,
+    .image_load = stub_load, .image_save = stub_save,
+};
+
+static void touch(const char* path)
+{
+    FILE* f = fopen(path, "wb");
+    assert(f);
+    fclose(f);
+}
+
+static void reset_mods(void)
+{
+    free(s_mods.e); free(s_mods.idx); free(s_mods.pool); free(s_mods.dumped);
+    memset(&s_mods, 0, sizeof s_mods);
+}
+
+int main(void)
+{
+    g.be = &stub;
+
+    /* ---- file names ---- */
+    assert(eng_mod_name_key("3f09a1c2b4d5e6f7.png") == 0x3f09a1c2b4d5e6f7ull);
+    assert(eng_mod_name_key("3F09A1C2B4D5E6F7_logo.PNG") == 0x3f09a1c2b4d5e6f7ull);
+    assert(eng_mod_name_key("3f09a1c2b4d5e6f.png") == 0);      /* 15 digits */
+    assert(eng_mod_name_key("3f09a1c2b4d5e6f7a.png") == 0);    /* a 17th digit */
+    assert(eng_mod_name_key("3f09a1c2b4d5e6f7.jpg") == 0);
+    assert(eng_mod_name_key("3f09a1c2b4d5e6f7") == 0);
+    assert(eng_mod_name_key("notes.txt") == 0);
+
+    /* ---- the key: content, base format and size; not the address ---- */
+    const u64 k1 = eng_texmod_key(0x1234, 0xA5, 64, 32);
+    assert(k1 && k1 == eng_texmod_key(0x1234, 0xA5, 64, 32));
+    assert(k1 != eng_texmod_key(0x1235, 0xA5, 64, 32));
+    assert(k1 != eng_texmod_key(0x1234, 0xA5, 32, 64));
+    assert(k1 != eng_texmod_key(0x1234, 0xA6, 64, 32));
+    assert(k1 == eng_texmod_key(0x1234, 0x85, 64, 32));      /* the LN bit (0x20) does not count */
+
+    /* ---- packs: order, nesting, a missing one ---- */
+    char root[600];
+    { const char* tmp = getenv("TMPDIR");
+      snprintf(root, sizeof root, "%s/texpacks_XXXXXX", tmp && *tmp ? tmp : "/tmp"); }
+    assert(mkdtemp(root));
+    char p[700];
+    snprintf(p, sizeof p, "%s/hd", root);              mkdir(p, 0755);
+    snprintf(p, sizeof p, "%s/hd/ui", root);           mkdir(p, 0755);
+    snprintf(p, sizeof p, "%s/base", root);            mkdir(p, 0755);
+    snprintf(p, sizeof p, "%s/hd/1111111111111111_16x8.png", root);     touch(p);
+    snprintf(p, sizeof p, "%s/hd/ui/2222222222222222_4x4.png", root);   touch(p);
+    snprintf(p, sizeof p, "%s/base/1111111111111111_8x8.png", root);    touch(p);   /* hd wins */
+    snprintf(p, sizeof p, "%s/base/3333333333333333_8x8.png", root);    touch(p);
+    snprintf(p, sizeof p, "%s/base/readme.txt", root);                  touch(p);
+    setenv("PS3_MODS_DIR", root, 1);
+    setenv("PS3_MODS", " hd, base ,nothere", 1);
+    unsetenv("PS3_MODS_DUMP");
+    reset_mods();
+    assert(eng_mods_wanted() && s_mods.on && s_mods.npacks == 2 && s_mods.n == 3);
+    assert(eng_mod_find(0x1111111111111111ull)->pack == 0);
+    assert(eng_mod_find(0x2222222222222222ull)->pack == 0);
+    assert(eng_mod_find(0x3333333333333333ull)->pack == 1);
+    assert(!eng_mod_find(0x4444444444444444ull));
+
+    /* ---- a replacement: RGBA8 at its own size, mips down to 1x1 ---- */
+    memset(&st, 0, sizeof st);
+    u32 h = eng_texmod_apply(0x1111111111111111ull, 0xA5, 64, 32, 7, 0xAAE4);
+    assert(h && st.n_create == 1 && st.created_fmt == RSX_BE_FMT_R8G8B8A8);
+    assert(st.created_w == 16 && st.created_h == 8 && st.created_mips == 5);   /* 16,8,4,2,1 */
+    assert(st.created_remap == 0xAAE4 && st.created_rsx_fmt == 0xA5);          /* the original's sampling */
+    assert(st.n_upload == 5 && st.up_w[4] == 1 && st.up_h[4] == 1 && st.up_mip[4] == 4);
+    assert(st.first_texel[0] == 10 && st.first_texel[3] == 40);
+    /* no mips in the original: none in the replacement */
+    memset(&st, 0, sizeof st);
+    assert(eng_texmod_apply(0x2222222222222222ull, 0xA5, 4, 4, 1, 0) && st.created_mips == 1 && st.n_upload == 1);
+    /* unnormalised coordinates (0x40): the size must stay */
+    memset(&st, 0, sizeof st);
+    assert(eng_texmod_apply(0x3333333333333333ull, 0xA5 | 0x40, 4, 4, 1, 0) == 0 && st.n_create == 0);
+    assert(eng_mod_find(0x3333333333333333ull)->bad);
+    assert(eng_texmod_apply(0x3333333333333333ull, 0xA5, 8, 8, 1, 0) == 0);   /* bad stays bad: no retry */
+    /* not in any pack */
+    assert(eng_texmod_apply(0x4444444444444444ull, 0xA5, 4, 4, 1, 0) == 0);
+
+    /* ---- the box filter ---- */
+    { const u8 src[2 * 2 * 4] = { 0,0,0,0,  4,8,12,16,  8,16,24,32,  12,24,36,48 };
+      u8 dst[4];
+      eng_rgba_half(src, 2, 2, dst, 1, 1);
+      assert(dst[0] == 6 && dst[1] == 12 && dst[2] == 18 && dst[3] == 24); }
+
+    /* ---- DXT1 for the dump: white/black palette ---- */
+    { const u8 blk[8] = { 0xFF, 0xFF, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00 };   /* texel 1 = index 1 */
+      u8 rgba[4 * 4 * 4];
+      eng_bc_decode(blk, 8, 4, 4, RSX_TEXFMT_BC1, rgba);
+      assert(rgba[0] == 255 && rgba[3] == 255);                 /* texel 0: c0 white */
+      assert(rgba[4] == 0 && rgba[5] == 0 && rgba[7] == 255); } /* texel 1: c1 black */
+
+    /* ---- end to end: a guest texture, replaced by content ---- */
+    vm_base = (u8*)calloc(2u << 20, 1);
+    const u32 off = 0x1000, W = 16, H = 16, FMT = 0xA5;        /* A8R8G8B8, linear */
+    for (u32 i = 0; i < W * H; i++) { vm_base[off + i * 4] = 0xFF; vm_base[off + i * 4 + 1] = (u8)i; }
+    int readable = 0;
+    const u64 content = eng_texture_content_hash(RSX_LOCATION_MAIN, off, W * H * 4, &readable);
+    assert(readable);
+    const u64 key = eng_texmod_key(content, FMT, W, H);
+    snprintf(p, sizeof p, "%s/base/%016llx_32x32.png", root, (unsigned long long)key);
+    touch(p);
+    char dump[700];
+    snprintf(dump, sizeof dump, "%s/dump", root);
+    setenv("PS3_MODS_DUMP", dump, 1);
+    reset_mods();
+    memset(&st, 0, sizeof st);
+    u32 hnd = eng_texture_upload(RSX_LOCATION_MAIN, off, FMT, W, H, 1, W * 4, 0, 0xAAE4, 1);
+    assert(hnd && st.created_w == 32 && st.created_h == 32);   /* the pack's, not the guest's */
+    assert(st.n_save == 1 && st.saved_w == W && st.saved_h == H);   /* and the original dumped */
+    { char want[700]; snprintf(want, sizeof want, "%s/%016llx.png", dump, (unsigned long long)key);
+      assert(!strcmp(st.saved_path, want)); }
+    /* the game rewrites the texture: a new key, no replacement, the original
+     * uploaded and dumped once */
+    vm_base[off] ^= 0x5A;
+    memset(&st, 0, sizeof st);
+    hnd = eng_texture_upload(RSX_LOCATION_MAIN, off, FMT, W, H, 1, W * 4, 0, 0xAAE4, 1);
+    assert(hnd && st.created_w == W && st.created_h == H && st.n_save == 1);
+    memset(&st, 0, sizeof st);
+    eng_texture_upload(RSX_LOCATION_MAIN, off, FMT, W, H, 1, W * 4, 0, 0xAAE4, 1);
+    assert(st.n_save == 0);                                    /* once a key */
+
+    /* ---- the level-0 key: a mipmapped texture whose smaller level changes
+     * between loads (PES 2013 uploads its kits before their mips are filled)
+     * still finds a pack file named by its level 0 ---- */
+    {
+        const u32 off2 = 0x8000;
+        for (u32 i = 0; i < W * H; i++) { vm_base[off2 + i * 4] = 0xFF; vm_base[off2 + i * 4 + 2] = (u8)(i * 3); }
+        int r0 = 0;
+        const u64 c0 = eng_texture_content_hash(RSX_LOCATION_MAIN, off2, W * H * 4, &r0);
+        assert(r0);
+        const u64 key0 = eng_texmod_key_level0(c0, FMT, W, H);
+        assert(key0 != eng_texmod_key(c0, FMT, W, H));
+        snprintf(p, sizeof p, "%s/base/%016llx_32x32.png", root, (unsigned long long)key0);
+        touch(p);
+        reset_mods();
+        memset(&st, 0, sizeof st);
+        hnd = eng_texture_upload(RSX_LOCATION_MAIN, off2, FMT, W, H, 2, W * 4, 0, 0xAAE4, 1);
+        assert(hnd && st.created_w == 32);                     /* replaced by the level-0 file */
+        /* the same image without mips (another copy of it): the same file */
+        memcpy(vm_base + 0x20000, vm_base + off2, W * H * 4);
+        memset(&st, 0, sizeof st);
+        assert(eng_texture_upload(RSX_LOCATION_MAIN, 0x20000, FMT, W, H, 1, W * 4, 0, 0xAAE4, 1)
+               && st.created_w == 32);
+        { char ix[760]; snprintf(ix, sizeof ix, "%s/textures-level0.txt", dump);
+          FILE* f = fopen(ix, "r"); assert(f);
+          char line[128], want[40]; int seen = 0;
+          snprintf(want, sizeof want, "%016llx", (unsigned long long)key0);
+          while (fgets(line, sizeof line, f)) seen |= strstr(line, want) != NULL;
+          fclose(f); assert(seen); }                           /* and listed by the dump */
+        vm_base[off2 + W * H * 4 + 5] ^= 0x77;                 /* level 1 differs, level 0 does not */
+        memset(&st, 0, sizeof st);
+        hnd = eng_texture_upload(RSX_LOCATION_MAIN, off2, FMT, W, H, 2, W * 4, 0, 0xAAE4, 1);
+        assert(hnd && st.created_w == 32);                     /* still replaced */
+        vm_base[off2 + 9] ^= 0x33;                             /* level 0 differs: not replaced */
+        memset(&st, 0, sizeof st);
+        hnd = eng_texture_upload(RSX_LOCATION_MAIN, off2, FMT, W, H, 2, W * 4, 0, 0xAAE4, 1);
+        assert(hnd && st.created_w == W);
+    }
+
+    /* ---- off: nothing runs ---- */
+    unsetenv("PS3_MODS");
+    unsetenv("PS3_MODS_DUMP");
+    reset_mods();
+    assert(!eng_mods_wanted());
+    memset(&st, 0, sizeof st);
+    hnd = eng_texture_upload(RSX_LOCATION_MAIN, off, FMT, W, H, 1, W * 4, 0, 0xAAE4, 1);
+    assert(hnd && st.n_load == 0 && st.n_save == 0 && st.created_w == W);
+
+    reset_mods();
+    snprintf(p, sizeof p, "rm -rf '%s'", root);
+    if (system(p) != 0) fprintf(stderr, "could not remove %s\n", root);
+    printf("test_texture_packs: ok\n");
+    return 0;
+}
diff --git a/libs/video/tests/test_vp_const_usage.c b/libs/video/tests/test_vp_const_usage.c
new file mode 100644
index 00000000..d7f65db3
--- /dev/null
+++ b/libs/video/tests/test_vp_const_usage.c
@@ -0,0 +1,114 @@
+/*
+ * rsx_vp_analyze_constants against the decompiler it describes.
+ *
+ * The draw engine uploads only the vp_c[] rows this analysis reports, so a row
+ * it misses is a constant the shader reads as stale data. The check here is
+ * not against a second decoding of the fields but against the HLSL the
+ * decompiler actually emits: random programs are decompiled, every vp_c[...]
+ * in the text is collected, and each fixed index must fall inside the
+ * reported range, and a relative read in the shader must be reported as
+ * `relative` (the converse is allowed: it only costs a full upload).
+ *
+ * Build (from the repo root):
+ *   clang -std=gnu17 -Wall -Wextra -I include -I libs/video \
+ *     -o /tmp/test_vp_const_usage libs/video/tests/test_vp_const_usage.c \
+ *     libs/video/rsx_vp_decompiler.c
+ */
+#include "rsx_vp_decompiler.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int fails;
+#define CHECK(c, ...) do { if (!(c)) { fails++; if (fails <= 20) { \
+    printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); } } } while (0)
+
+static uint64_t rng = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd(void)
+{
+    rng ^= rng << 13; rng ^= rng >> 7; rng ^= rng << 17;
+    return (uint32_t)rng;
+}
+
+static void put_le(uint8_t* p, uint32_t v)
+{
+    p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8);
+    p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24);
+}
+
+/* One instruction with chosen source types. Opcodes are random over the
+ * whole field; flow-control and unknown ops are left in on purpose, since
+ * the analysis has to cover whatever the decompiler emits for them too. */
+static void make_instr(uint8_t* p, int last, int relative_bias)
+{
+    uint32_t d0 = rnd(), d1 = rnd(), d2 = rnd(), d3 = rnd();
+    /* Bias the source types toward constants (type 3) so most programs
+     * exercise the analysis. */
+    if (rnd() & 1) d1 = (d1 & ~0xFFu) | (((d1 & 0xFFu) & ~1u) | 1u);    /* src0 hi bits */
+    if (rnd() & 1) d2 = (d2 & ~(3u << 6)) | (3u << 6);                  /* src1 type = 3 */
+    if (rnd() & 1) d3 = (d3 & ~(3u << 21)) | (3u << 21);                /* src2 type low bits */
+    if (rnd() & 1) d2 = (d2 & ~(3u << 23)) | (3u << 23);                /* src0 type = 3 */
+    if (!relative_bias) d3 &= ~2u;          /* index_const off */
+    d3 &= ~1u;
+    if (last) d3 |= 1u;
+    put_le(p + 0, d0); put_le(p + 4, d1); put_le(p + 8, d2); put_le(p + 12, d3);
+}
+
+static char hlsl[1 << 20];
+
+int main(void)
+{
+    enum { PROGRAMS = 20000, MAXI = 24 };
+    static uint8_t uc[MAXI * 16];
+    int decompiled = 0, ranged = 0, relative = 0, over_relative = 0;
+    for (int n = 0; n < PROGRAMS; n++) {
+        const int instrs = 1 + (int)(rnd() % MAXI);
+        const int rel = (rnd() % 4) == 0;
+        for (int i = 0; i < instrs; i++) make_instr(uc + i * 16, i == instrs - 1, rel);
+
+        rsx_vp_const_usage u;
+        const int ai = rsx_vp_analyze_constants(uc, (uint32_t)instrs * 16u, &u);
+        CHECK(ai == instrs && u.valid, "program %d: analysis returned %d (valid %d) for %d instrs",
+              n, ai, u.valid, instrs);
+
+        const int r = rsx_vp_decompile(uc, (uint32_t)instrs * 16u, hlsl, sizeof hlsl);
+        if (r < 0) continue;
+        decompiled++;
+
+        int saw_relative = 0;
+        for (const char* q = hlsl; (q = strstr(q, "vp_c[")) != NULL; q += 5) {
+            const char* idx = q + 5;
+            /* The cbuffer declaration, not a read. */
+            if (q - hlsl >= 7 && !strncmp(q - 7, "float4 ", 7)) continue;
+            if (*idx == '(') { saw_relative = 1; continue; }
+            const unsigned c = (unsigned)strtoul(idx, NULL, 10);
+            CHECK(!u.relative ? (u.lo <= u.hi && c >= u.lo && c <= u.hi) : 1,
+                  "program %d: shader reads vp_c[%u] outside [%u, %u]", n, c, u.lo, u.hi);
+        }
+        /* One-way: a relative read the analysis misses would leave rows
+         * unwritten. Reporting relative for a source the opcode never reads
+         * only costs a full copy, so it is allowed and counted. */
+        CHECK(!saw_relative || u.relative,
+              "program %d: shader reads relatively, analysis did not say so", n);
+        if (u.relative && !saw_relative) over_relative++;
+        if (u.relative) relative++; else if (u.lo <= u.hi) ranged++;
+    }
+
+    /* No end flag: the analysis must refuse to give a range. */
+    for (int i = 0; i < 4; i++) make_instr(uc + i * 16, 0, 0);
+    rsx_vp_const_usage u;
+    CHECK(rsx_vp_analyze_constants(uc, 4 * 16u, &u) < 0 && !u.valid,
+          "unterminated program accepted");
+    /* NULL input. */
+    CHECK(rsx_vp_analyze_constants(NULL, 16, &u) < 0 && !u.valid, "NULL ucode accepted");
+
+    printf("test_vp_const_usage: %d programs decompiled (%d ranged, %d relative, %d of those"
+           " conservatively), %d failure(s)\n", decompiled, ranged, relative, over_relative, fails);
+    if (decompiled < PROGRAMS / 2 || ranged < 1000 || relative < 100) {
+        printf("FAIL: too few programs exercised the check\n");
+        return 1;
+    }
+    return fails ? 1 : 0;
+}
