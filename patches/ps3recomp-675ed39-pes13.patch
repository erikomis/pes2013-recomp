+          static px4 big[4 * W * H];
+          [dst getBytes:big bytesPerRow:2 * W * 4 fromRegion:MTLRegionMake2D(0, 0, 2 * W, 2 * H) mipmapLevel:0];
+          int off = 0;
+          for (int i = 0; i < 4 * W * H; i++) off |= abs((int)big[i][0] - 90) > 2;
