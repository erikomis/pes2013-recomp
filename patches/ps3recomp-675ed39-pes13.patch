+
+static u64 eng_texmod_key(u64 content, u32 fmt, u32 w, u32 h)
+{
+    u64 k = content ^ (((((u64)(fmt & 0x9Fu)) << 48) | ((u64)w << 24) | (u64)h) * 0x9E3779B97F4A7C15ull);
+    k ^= k >> 33; k *= 0xFF51AFD7ED558CCDull; k ^= k >> 33; k *= 0xC4CEB9FE1A85EC53ull; k ^= k >> 33;
+    return k ? k : 1u;
+}
+
+/* The level-0 key: a different mix, so it never equals a full key. */
+static u64 eng_texmod_key_level0(u64 content, u32 fmt, u32 w, u32 h)
+{
+    return eng_texmod_key(content ^ 0x4C3056454C30304Bull, fmt, w, h);
