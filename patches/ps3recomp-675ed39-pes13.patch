+/* A backend that takes a range of rows gets them with a generation that moves
+ * exactly when a row is written, and the epilogue beside them. */
+static struct { int calls; u32 gen, first, count; float xf[8]; u32 row3; } s_vsr;
+static void stub_vs_range(void* u, const void* rows, u32 gen, u32 first, u32 count,
+                          const void* tail, u32 tail_bytes)
+{
+    (void)u;
+    s_vsr.calls++;
+    s_vsr.gen = gen;
+    s_vsr.first = first;
+    s_vsr.count = count;
+    s_vsr.row3 = ((const u32*)rows)[3 * 4];
+    CHECK(tail_bytes == sizeof s_vsr.xf, "the epilogue comes whole (%u)", tail_bytes);
+    memcpy(s_vsr.xf, tail, sizeof s_vsr.xf);
