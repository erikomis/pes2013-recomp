+    }
+    if (active && kind == PS3_PAD_EVENT_GOAL && (t / 250) % 2 == 0) c[0] = c[1] = c[2] = 255;
+    if (c[0] == s_dsx.lr && c[1] == s_dsx.lg && c[2] == s_dsx.lb) return;
+    if (now - s_dsx.led_ms < 40) return;
+    if (SDL_GameControllerSetLED(gc, c[0], c[1], c[2]) == 0) {
+        s_dsx.lr = c[0]; s_dsx.lg = c[1]; s_dsx.lb = c[2]; s_dsx.led_ms = now;
+    }
