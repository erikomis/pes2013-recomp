@@ -0,0 +1,22 @@
+/*
+ * ps3recomp - cellMusic (custom soundtrack) HLE
+ *
+ * The music utility plays the user's own tracks in place of a title's music.
+ * There is no music library here, so initialisation reports that the utility
+ * is unavailable, as a console with no music would leave the title on its own
+ * soundtrack. Before this existed the import was unresolved and answered
+ * CELL_OK, so a title could wait for an initialise callback that never came.
+ */
+
+#include "ps3emu/ps3types.h"
+#include "ps3emu/error_codes.h"
+#include <stdio.h>
+
+#define CELL_MUSIC_ERROR_GENERIC 0x8002C1FF
+
+s32 cellMusicInitialize2(s32 mode, s32 spuPriority, u32 func, u32 userData)
+{
+    (void)func; (void)userData;
+    printf("[cellMusic] Initialize2(mode=%d, spuPriority=%d) -> unavailable\n", mode, spuPriority);
+    return (s32)CELL_MUSIC_ERROR_GENERIC;
+}
