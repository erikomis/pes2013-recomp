+          rsx_vertex_layout_plan_init(&narrow.layout, mask);
+          for (int which = 0; which < 2; which++) {
+              const rsx_vertex_fetch_plan* p = which ? &narrow : &plan;
+              const u32 out_stride = p->layout.stride ? p->layout.stride : 16u;
+              if (!rsx_vertex_fetch_batch(p, refs, count, batch, out_stride)) continue;
+              batches++;
+              int ok = 1;
+              for (u32 i = 0; i < count && ok; i++)
+                  ok = rsx_vertex_fetch_one(p, &refs[i], single + (size_t)i * out_stride);
+              CHECK(ok, "plan %d: batch succeeded where fetch_one fails", n);
+              CHECK(!ok || !p->layout.stride ||
+                    !memcmp(batch, single, (size_t)count * p->layout.stride),
+                    "plan %d: batch differs from fetch_one", n);
+          } }
+
+        /* The remap, direct table or hash, against first-use order worked out by hand. */
+        { static rsx_vertex_remap remap;
+          static rsx_vertex_ref in[MAXV], want[MAXV];
+          static u32 want_map[MAXV];
+          u32 want_n = 0;
+          const u32 shape = rnd() % 4;           /* short range, wide range, mixed base */
+          for (u32 i = 0; i < count; i++) {
+              in[i].vertex_id = shape == 0 ? rnd() % 40u : shape == 1 ? rnd() % 3000u
+                              : shape == 2 ? rnd() : 7000u + rnd() % 900u;
+              in[i].base_index = (shape == 2 && rnd() % 2) ? 5u : base;
+              u32 k = 0;
+              while (k < want_n && (want[k].vertex_id != in[i].vertex_id ||
+                                    want[k].base_index != in[i].base_index)) k++;
+              if (k == want_n) want[want_n++] = in[i];
+              want_map[i] = k;
+          }
+          u32 got_n = 0;
+          CHECK(rsx_vertex_remap_build(&remap, in, count, &got_n), "plan %d: remap failed", n);
+          CHECK(got_n == want_n && !memcmp(in, want, (size_t)want_n * sizeof(in[0])),
+                "plan %d: remap unique set (%u, want %u)", n, got_n, want_n);
+          for (u32 i = 0; i < count; i++)
+              CHECK(rsx_vertex_remap_index(&remap, i) == want_map[i], "plan %d: remap map", n);
+        }
     }
 
