+static u32 vk_post_frame(void* user, u32 surface)
+{
+    vk_pp_read();
+    if (!s_post.aa && !(s_post.sharpen > 0.0f) && s_post.vib == 0.0f && s_post.con == 1.0f) return surface;
+    if (s_post.failed || !s_g.on) return surface;
+    const vk_eng_obj* o = vk_eng_get(surface, VK_ENG_COLOR);
+    if (!o || o->fmt != VK_FORMAT_R8G8B8A8_UNORM) return surface;
+    const u32 w = o->w, h = o->h;
+    if (vk_pp_build(user) || vk_pp_targets(user, w, h)) return surface;
+
+    /* What the engine has bound, put back after. */
+    const struct vk_eng_bound_save { u8 b[sizeof s_eng_bound]; } bound_save = *(const struct vk_eng_bound_save*)&s_eng_bound;
+    const u32 pipe = s_e2.pipeline, vsb = s_e2.vs_bytes, psb = s_e2.ps_bytes, tmask = s_e2.tex_mask;
+    u32 tex[RSX_BE_MAX_TEXTURES];
+    rsx_be_sampler_desc samp[RSX_BE_MAX_TEXTURES];
+    memcpy(tex, s_e2.tex, sizeof tex);
+    memcpy(samp, s_e2.samp, sizeof samp);
+    float vp[4]; u32 sc[4];
+    memcpy(vp, s_e2.vp, sizeof vp); memcpy(sc, s_e2.sc, sizeof sc);
+    const int hvp = s_e2.have_vp, hsc = s_e2.have_sc;
+    u8 pcs[64];
+    u8* const pcu = vk_eng_ucpu() ? vk_eng_ucpu() + s_g.ps_off : NULL;
+    if (pcu) memcpy(pcs, pcu, sizeof pcs);
+
+    float pc[16] = { 1.0f / (float)w, 1.0f / (float)h, (float)w, (float)h,
+                     s_post.sharpen, s_post.vib, s_post.con, 0.0f };
+    u32 cur = surface;
+    if (s_post.aa) {
+        static const float zero[4] = { 0, 0, 0, 0 };
+        u32 t[RSX_BE_MAX_TEXTURES] = { 0 };
+        vk_eng_clear_color(user, s_post.edges, zero);
+        t[0] = cur;
+        vk_pp_pass(user, s_post.pipe_edge, s_post.edges, t, pc);
+        memset(t, 0, sizeof t);
+        t[1] = s_post.edges; t[2] = s_post.area; t[3] = s_post.search;
+        vk_eng_clear_color(user, s_post.weights, zero);
+        vk_pp_pass(user, s_post.pipe_weight, s_post.weights, t, pc);
+        memset(t, 0, sizeof t);
+        t[0] = cur; t[4] = s_post.weights;
+        vk_pp_pass(user, s_post.pipe_blend, s_post.aa_out, t, pc);
+        cur = s_post.aa_out;
+    }
+    if (s_post.pipe_final) {
+        u32 t[RSX_BE_MAX_TEXTURES] = { 0 };
+        t[0] = cur;
+        vk_pp_pass(user, s_post.pipe_final, s_post.fin, t, pc);
+        cur = s_post.fin;
+    }
+
+    *(struct vk_eng_bound_save*)&s_eng_bound = bound_save;
+    s_e2.pipeline = pipe; s_e2.vs_bytes = vsb; s_e2.ps_bytes = psb; s_e2.tex_mask = tmask;
+    memcpy(s_e2.tex, tex, sizeof tex);
+    memcpy(s_e2.samp, samp, sizeof samp);
+    memcpy(s_e2.vp, vp, sizeof vp); memcpy(s_e2.sc, sc, sizeof sc);
+    s_e2.have_vp = hvp; s_e2.have_sc = hsc;
+    if (pcu) memcpy(pcu, pcs, sizeof pcs);
+    return cur;
+}
