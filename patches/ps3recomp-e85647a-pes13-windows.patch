 }
 
+/* FS_IO_LOG=<substring>: every read (R; A for an AIO read) and write on a file whose path contains it, with
+ * how many of the bytes are not zero: is a scratch file read back as written? */
+static void fs_io_log(char op, int fd, long pos, uint64_t want, size_t got, uint32_t buf, ppu_context* ctx)
+{
+    static const char* match = (const char*)-1;
+    if (match == (const char*)-1) match = getenv("FS_IO_LOG");
+    if (!match || fd < 0 || fd >= FS_MAX || !strstr(g_fd_path[fd], match)) return;
+    size_t nz = 0;
+    for (size_t i = 0; i < got; i++) nz += vm_base[buf + i] != 0;
+    fprintf(stderr, "[fsio] %c fd=%d pos=0x%lX want=%llu got=%zu nz=%zu buf=0x%08X lr=0x%08X tid=%u\n", op, fd, pos,
+            (unsigned long long)want, got, nz, buf, (uint32_t)ctx->lr, (unsigned)ctx->thread_id);
+}
+
 static void cellFsRead(ppu_context* ctx)
 {
     int fd          = (int)(uint32_t)ctx->gpr[3];
@@ -542,6 +555,7 @@ static void cellFsRead(ppu_context* ctx)
     vm_note_write(buf, (size_t)nbytes);   /* kernel write into guest memory */
     size_t n = fread(vm_base + buf, 1, (size_t)nbytes, f);   /* raw bytes, no swap */
     vm_note_write_check(n < (size_t)nbytes && ferror(f) && errno == EFAULT, "cellFsRead");
+    fs_io_log('R', fd, fpos_before, nbytes, n, buf, ctx);
     /* PS3_FSLOG_EOF=<fd>,<bytes>: report end-of-file past <bytes> on one descriptor.
      * The intro cinematic is 28 seconds and this port renders it at a few frames
      * a second, so it cannot be watched to its end -- truncating the stream makes
@@ -611,7 +625,9 @@ static void cellFsWrite(ppu_context* ctx)
     fs_prefault(buf, nbytes);   /* kernel READS the buffer; same reserved-page trap */
     fs_set_dir(fd, f, 2);
     clearerr(f);    /* ferror() is sticky: an old failure would look like this write's */
+    const long fpos_w = ftell(f);
     size_t n = fwrite(vm_base + buf, 1, (size_t)nbytes, f);
+    fs_io_log('W', fd, fpos_w, nbytes, n, buf, ctx);
     /* Flush here: a small write only reaches the kernel at the flush, so an
      * unflushed one always looks like it worked. */
     const int write_failed = ps3_fs_write_failed(n, nbytes, fflush(f) != 0 || ferror(f));
@@ -972,6 +988,19 @@ static void cellFsUnlink(ppu_context* ctx)
     }
     ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)error;
 }
+static void cellFsRename(ppu_context* ctx)
+{
+    char gfrom[1024], gto[1024], hfrom[1100], hto[1100];
+    guest_strcpy(gfrom, (uint32_t)ctx->gpr[3], sizeof gfrom);
+    guest_strcpy(gto,   (uint32_t)ctx->gpr[4], sizeof gto);
+    host_path(hfrom, sizeof hfrom, gfrom);
+    host_path(hto,   sizeof hto,   gto);
+    remove(hto);                       /* rename-over: Windows refuses an existing target */
+    int r = rename(hfrom, hto);
+    if (getenv("PS3_FSLOG") || r != 0)
+        fprintf(stderr, "[fs] rename '%s' -> '%s' (%s)\n", gfrom, gto, r == 0 ? "OK" : strerror(errno));
+    ctx->gpr[3] = (r == 0) ? CELL_OK : (uint64_t)(int64_t)(int32_t)CELL_FS_ENOENT;
+}
 static void cellFsFsync(ppu_context* ctx)
 {
     int fd = (int)(uint32_t)ctx->gpr[3];
@@ -1160,6 +1189,7 @@ static void fs_aio_submit(ppu_context* ctx, bool write)
         HOST_UNLOCKFILE(f);
         err = (!write || n == size) ? CELL_OK : CELL_FS_EIO;
     }
+    if (err == CELL_OK) fs_io_log('A', fd, (long)offset, size, n, buf, ctx);
     if (ps3_env_once("PS3_FSLOG"))
         fprintf(stderr, "[fs] aio %s id=%d fd=%d off=%llu size=%llu -> %zu\n", write ? "write" : "read",
                 id, fd, (unsigned long long)offset, (unsigned long long)size, n);
@@ -1241,6 +1271,7 @@ extern "C" void ppu_fs_register(void)
     ps3_hle_register_ctx(ps3_compute_nid("cellFsMkdir"),    "cellFsMkdir",    cellFsMkdir);
     ps3_hle_register_ctx(ps3_compute_nid("cellFsRmdir"),    "cellFsRmdir",    cellFsRmdir);
     ps3_hle_register_ctx(ps3_compute_nid("cellFsUnlink"),   "cellFsUnlink",   cellFsUnlink);
+    ps3_hle_register_ctx(ps3_compute_nid("cellFsRename"),   "cellFsRename",   cellFsRename);
     ps3_hle_register_ctx(ps3_compute_nid("cellFsFsync"),    "cellFsFsync",    cellFsFsync);
     ps3_hle_register_ctx(ps3_compute_nid("cellFsFtruncate"), "cellFsFtruncate", cellFsFtruncate);
     ps3_hle_register_ctx(ps3_compute_nid("cellFsGetFreeSize"),   "cellFsGetFreeSize",   cellFsGetFreeSize);
