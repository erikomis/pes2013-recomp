+/* This poll's light bar and speaker state for controller gc. */
+static void pad_dsx_poll(SDL_GameController* gc)
+{
+    const unsigned long long now = pad_now_ms();
+    const int kind = __atomic_load_n(&s_dsx.kind, __ATOMIC_ACQUIRE);
+    const unsigned long long t = now - s_dsx.start_ms;
+    const int active = kind && t < pad_event_length(kind);
+    if (kind && !active) __atomic_store_n(&s_dsx.kind, 0, __ATOMIC_RELEASE);
