+/* PS3_AUDIO_MUTE=1 (or PS3_MUTE=1): silence at the device, nothing else changes
+ * -- the title still has a working cellAudio, paced as before. PS3_AUDIO_VOLUME=
+ * 0..100: the host output's level, applied to what is queued. */
+static float audio_host_gain(void)
+{
+    static float gain = -1.0f;
+    if (gain < 0.0f) {
+        const char* m = getenv("PS3_AUDIO_MUTE");
+        const char* m2 = getenv("PS3_MUTE");
+        const char* v = getenv("PS3_AUDIO_VOLUME");
+        gain = 1.0f;
+        if (v && *v) {
+            const int pct = atoi(v);
+            gain = pct <= 0 ? 0.0f : pct >= 100 ? 1.0f : (float)pct / 100.0f;
+        }
+        if ((m && atoi(m)) || (m2 && atoi(m2))) gain = 0.0f;
+    }
+    return gain;
+}
+
+/* The DualSense's speaker (ps3_audio_controller_burst, from a port through
+ * cellPad's goal event): for a while the game's mix also goes to the
+ * controller's USB audio output (4 channels: the first two are what the
+ * speaker plays once cellPad switches it on). The device opens the first
+ * time and stays open; only a burst sends anything. No DualSense on USB: no
+ * output, said once. */
+static SDL_AudioDeviceID s_ctl_dev = 0;
+static int s_ctl_channels = 0;
+static volatile unsigned long long s_ctl_until_ms = 0;
+
+static unsigned long long audio_now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (unsigned long long)ts.tv_sec * 1000ull + (unsigned long long)(ts.tv_nsec / 1000000);
+}
+
+void ps3_audio_controller_burst(unsigned ms)
+{
+    static int tried = 0;
+    if (!s_ctl_dev && !tried) {
+        tried = 1;
+        if (SDL_WasInit(SDL_INIT_AUDIO) == 0 && SDL_InitSubSystem(SDL_INIT_AUDIO) < 0) return;
+        const char* name = NULL;
+        const int n = SDL_GetNumAudioDevices(0);
+        for (int i = 0; i < n && !name; i++) {
+            const char* d = SDL_GetAudioDeviceName(i, 0);
+            if (d && strcasestr(d, "DualSense")) name = d;
+        }
+        if (!name) { printf("[cellAudio] no DualSense audio output (the speaker needs the USB cable)\n"); return; }
+        SDL_AudioSpec want, have;
+        memset(&want, 0, sizeof want);
+        want.freq = CELL_AUDIO_SAMPLE_RATE;
+        want.format = AUDIO_F32SYS;
+        want.channels = 4;
+        want.samples = CELL_AUDIO_BLOCK_SAMPLES;
+        s_ctl_dev = SDL_OpenAudioDevice(name, 0, &want, &have, 0);
+        if (!s_ctl_dev) { printf("[cellAudio] %s: open failed: %s\n", name, SDL_GetError()); return; }
+        s_ctl_channels = have.channels;
+        SDL_PauseAudioDevice(s_ctl_dev, 0);
+        printf("[cellAudio] controller speaker output: %s, %d channels\n", name, have.channels);
+    }
+    if (s_ctl_dev) s_ctl_until_ms = audio_now_ms() + ms;
+}
+
+/* One burst: the game's mix, mono, on the speaker's two channels with the
+ * lows cut (a small speaker only distorts them), and its lows on the haptic
+ * channels (3 and 4: the DualSense's voice coils), so the controller also
+ * shakes with the crowd. It fades in over 150 ms and out over the last 600 ms,
+ * and starts with 40 ms of silence queued so the device never runs dry at the
+ * start. PS3_PAD_HAPTIC_AUDIO=0 keeps the haptic channels silent. */
+static void audio_controller_submit(const float* stereo, u32 num_samples, float gain)
+{
+    if (!s_ctl_dev) return;
+    static unsigned long long started_for = 0;
+    static float hp_x = 0, hp_y = 0, lp = 0;
+    const unsigned long long now = audio_now_ms(), until = s_ctl_until_ms;
+    if (now >= until) { started_for = 0; return; }
+    const Uint32 frame = (Uint32)(s_ctl_channels * sizeof(float));
+    float out[CELL_AUDIO_BLOCK_SAMPLES * 8];
+    if (started_for != until) {               /* a new burst */
+        started_for = until;
+        hp_x = hp_y = lp = 0;
+        SDL_ClearQueuedAudio(s_ctl_dev);
+        const u32 pre = CELL_AUDIO_SAMPLE_RATE / 25;     /* 40 ms */
+        memset(out, 0, sizeof out);
+        for (u32 k = 0; k < pre; k += CELL_AUDIO_BLOCK_SAMPLES)
+            SDL_QueueAudio(s_ctl_dev, out, CELL_AUDIO_BLOCK_SAMPLES * frame);
+    }
+    /* the speaker follows the picture: never more than about 150 ms behind */
+    if (SDL_GetQueuedAudioSize(s_ctl_dev) > (Uint32)(CELL_AUDIO_SAMPLE_RATE * 3 / 20) * frame) return;
+    static int haptic = -1;
+    if (haptic < 0) { const char* e = getenv("PS3_PAD_HAPTIC_AUDIO"); haptic = !(e && e[0] == '0'); }
+    const unsigned long long dur = 6000;
+    const unsigned long long t = dur - (until - now);           /* ms into the burst */
+    float env = 1.0f;
+    if (t < 150) env = (float)t / 150.0f;
+    if (until - now < 600) env = (float)(until - now) / 600.0f;
+    const float a_hp = 0.98f;      /* one-pole high-pass, about 150 Hz at 48 kHz */
+    const float a_lp = 0.015f;     /* one-pole low-pass, about 115 Hz */
+    while (num_samples) {
+        const u32 n = num_samples < CELL_AUDIO_BLOCK_SAMPLES ? num_samples : CELL_AUDIO_BLOCK_SAMPLES;
+        for (u32 i = 0; i < n; i++) {
+            const float m = 0.5f * (stereo[i * 2] + stereo[i * 2 + 1]) * gain * env;
+            const float y = a_hp * (hp_y + m - hp_x);
+            hp_x = m; hp_y = y;
+            lp += a_lp * (m - lp);
+            float sp = y * 1.6f, hv = haptic ? lp * 4.0f : 0.0f;
+            if (sp > 1.0f) sp = 1.0f; if (sp < -1.0f) sp = -1.0f;
+            if (hv > 1.0f) hv = 1.0f; if (hv < -1.0f) hv = -1.0f;
+            for (int c = 0; c < s_ctl_channels && c < 8; c++)
+                out[i * s_ctl_channels + c] = c < 2 ? sp : c < 4 ? hv : 0.0f;
+        }
+        SDL_QueueAudio(s_ctl_dev, out, n * frame);
+        stereo += n * 2;
+        num_samples -= n;
+    }
+}
