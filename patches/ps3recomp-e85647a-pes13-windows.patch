                 if (plan.attr[at].desc.frequency > 1) divided++;
             }
         }
+
+        /* The batch fetch against the per-vertex one it stands in for, bit for bit. */
+        { static u8 batch[MAXV * 16u * 16u], single[MAXV * 16u * 16u];
+          /* An attribute with no stable span sends a whole draw to fetch_one, and a
+           * random plan of sixteen nearly always has one, so also try this plan with
+           * only the attributes the batch can take. */
+          rsx_vertex_fetch_plan narrow = plan;
+          u32 mask = 0;
+          for (u32 at = 0; at < RSX_DSP_NUM_VERTEX_ATTR; at++)
