+/* test8: an id the title destroyed must stay dead after its slot is reused. PES 2013's
+ * uncompress thread waited on the lock of a file object already closed; the slot had
+ * since been given to a thread's start semaphore, and the wait blocked on it for ever.
+ * LV2 answers ESRCH for a destroyed id, and the semaphore now in the slot is untouched. */
+static int test8_stale_id_after_reuse(void)
+{
+    const char* name = "test8_stale_id_after_reuse";
+    LONG before = g_fail_count;
+    ppu_context ctx; ctx_init_for_thread(&ctx, alloc_tid());
+    uint32_t sattr = make_sema_attr(SYS_SYNC_FIFO);
+    uint32_t addr = guest_alloc(4);
+    int32_t rc = call4((int64_t(*)(ppu_context*))sys_semaphore_create, &ctx, addr, sattr, 1, 1);
+    if (rc != CELL_OK) { fail(name, "create rc=0x%08X", (unsigned)rc); return 1; }
+    const uint32_t old_id = read_be32(addr);
+    rc = call1((int64_t(*)(ppu_context*))sys_semaphore_destroy, &ctx, old_id);
+    if (rc != CELL_OK) fail(name, "destroy rc=0x%08X", (unsigned)rc);
+    /* create until the old id's slot is handed out again (round robin: within 256) */
+    uint32_t reused = 0, made[SYS_SEMAPHORE_MAX]; int nmade = 0;
+    for (int k = 0; k < SYS_SEMAPHORE_MAX && !reused; k++) {
+        rc = call4((int64_t(*)(ppu_context*))sys_semaphore_create, &ctx, addr, sattr, 0, 1);
+        if (rc != CELL_OK) { fail(name, "create #%d rc=0x%08X", k, (unsigned)rc); break; }
+        const uint32_t id = read_be32(addr);
+        made[nmade++] = id;
+        if (((id - 1) & 0xFFu) == ((old_id - 1) & 0xFFu)) reused = id;
+    }
+    if (!reused) fail(name, "the slot of id %u was never reused", (unsigned)old_id);
+    else {
+        if (reused == old_id) fail(name, "the destroyed id %u came back unchanged", (unsigned)old_id);
+        rc = call2((int64_t(*)(ppu_context*))sys_semaphore_wait, &ctx, old_id, (uint64_t)200000);
+        if (rc != (int32_t)CELL_ESRCH)
+            fail(name, "wait on the destroyed id rc=0x%08X (want ESRCH, not a wait on the new one)", (unsigned)rc);
+        rc = call2((int64_t(*)(ppu_context*))sys_semaphore_post, &ctx, old_id, 1);
+        if (rc != (int32_t)CELL_ESRCH) fail(name, "post on the destroyed id rc=0x%08X (want ESRCH)", (unsigned)rc);
+        rc = call2((int64_t(*)(ppu_context*))sys_semaphore_trywait, &ctx, reused, 0);
+        if (rc != (int32_t)CELL_EBUSY)
+            fail(name, "the new semaphore was changed by the stale post (trywait rc=0x%08X, want EBUSY)", (unsigned)rc);
+    }
+    for (int k = 0; k < nmade; k++) call1((int64_t(*)(ppu_context*))sys_semaphore_destroy, &ctx, made[k]);
+    printf("[%s] old=%u reused-slot id=%u -> %s\n", name, (unsigned)old_id, (unsigned)reused,
+           g_fail_count == before ? "PASS" : "FAIL");
+    return g_fail_count == before ? 0 : 1;
+}
