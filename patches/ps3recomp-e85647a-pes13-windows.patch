+/* UTF-16 (the title's) to UTF-8 and back, the Basic Multilingual Plane only. */
+static void osk_utf16_to_utf8(const CellOskDialogChar* src, char* dst, size_t room)
+{
+    size_t o = 0;
+    for (; *src && o + 4 < room; src++) {
+        unsigned c = *src;
+        if (c < 0x80) dst[o++] = (char)c;
+        else if (c < 0x800) { dst[o++] = (char)(0xC0 | (c >> 6)); dst[o++] = (char)(0x80 | (c & 0x3F)); }
+        else { dst[o++] = (char)(0xE0 | (c >> 12)); dst[o++] = (char)(0x80 | ((c >> 6) & 0x3F)); dst[o++] = (char)(0x80 | (c & 0x3F)); }
+    }
+    dst[o] = 0;
+}
+static u32 osk_utf8_to_utf16(const char* src, CellOskDialogChar* dst, u32 max)
+{
+    const unsigned char* p = (const unsigned char*)src;
+    u32 n = 0;
+    while (*p && n < max) {
+        unsigned c = *p++;
+        if (c >= 0xE0 && p[0] && p[1]) { c = ((c & 0x0F) << 12) | ((p[0] & 0x3F) << 6) | (p[1] & 0x3F); p += 2; }
+        else if (c >= 0xC0 && p[0]) { c = ((c & 0x1F) << 6) | (p[0] & 0x3F); p += 1; }
+        else if (c >= 0x80) c = '?';
+        dst[n++] = (CellOskDialogChar)c;
+    }
+    dst[n] = 0;
+    return n;
+}
