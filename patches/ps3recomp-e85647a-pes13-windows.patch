+/* The DualSense output report pieces SDL forwards (DS5EffectsState_t, 47
+ * bytes). `reset` clears the power-save bits another program (Steam Input)
+ * can leave set, which keep the light bar and trigger motors off. */
+static int pad_ds5_effect(SDL_GameController* gc, int reset, int speaker)
+{
+    if (SDL_GameControllerGetType(gc) != SDL_CONTROLLER_TYPE_PS5) return -1;
+    uint8_t st[47];
+    memset(st, 0, sizeof st);
+    if (reset) { st[1] |= 0x02; st[9] = 0x00; }
+    if (speaker >= 0) {
+        st[0] |= 0x80 | 0x20;                 /* audio control, speaker volume */
+        st[1] |= 0x80;                        /* audio control 2 (preamp) */
+        st[5] = speaker ? 0x64 : 0x00;        /* speaker volume */
+        st[7] = speaker ? (uint8_t)(3 << 4) : 0;   /* output path: the speaker */
+        st[37] = speaker ? 0x04 : 0x00;       /* speaker preamp gain */
+    }
+    return SDL_GameControllerSendEffect(gc, st, (int)sizeof st);
+}
