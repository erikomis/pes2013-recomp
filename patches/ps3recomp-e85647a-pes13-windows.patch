+/* Smooth an isolated jump at a guest block boundary over 32 samples
+ * (0.67 ms). Compare the edge to ordinary slopes on both sides so a
+ * natural transient within a block does not change the output. */
+static void audio_smooth_boundary(float previous[2], float slope_before[2])
+{
+    for (u32 channel = 0; channel < 2; channel++) {
+        const float delta = previous[channel] - s_mix_buffer[channel];
+        float nearby = slope_before[channel];
+        for (u32 frame = 1; frame <= 4; frame++) {
+            const u32 i = 2 * frame + channel;
+            const float slope = fabsf(s_mix_buffer[i] - s_mix_buffer[i - 2]);
+            if (slope > nearby) nearby = slope;
+        }
+        if (fabsf(delta) > 0.02f && fabsf(delta) > 3.0f * nearby) {
+            for (u32 frame = 0; frame < 32; frame++) {
+                const float t = (32.0f - (float)frame) / 32.0f;
+                const u32 i = 2 * frame + channel;
+                const float value = s_mix_buffer[i] + delta * t * t;
+                s_mix_buffer[i] = fminf(1.0f, fmaxf(-1.0f, value));
+            }
+        }
+        const u32 end = 2 * (CELL_AUDIO_BLOCK_SAMPLES - 1) + channel;
+        previous[channel] = s_mix_buffer[end];
+        slope_before[channel] = 0.0f;
+        for (u32 frame = 0; frame < 4; frame++) {
+            const u32 i = end - 2 * frame;
+            const float slope = fabsf(s_mix_buffer[i] - s_mix_buffer[i - 2]);
+            if (slope > slope_before[channel]) slope_before[channel] = slope;
+        }
+    }
+}
