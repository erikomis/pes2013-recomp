+/* ===========================================================================
+ * test7_semaphore_handoff
+ *
+ * lv2 hands a post to the threads already waiting: a thread that calls wait
+ * right after the post must not take the token from the waiter that was there
+ * first. A runtime that only bumps the count and signals lets the late caller
+ * win; the waiter then sleeps on with nobody left to post (PES 2013 hung that
+ * way). Also: destroy with a waiter is EBUSY, and a destroyed id stays dead
+ * for a while (the next create does not get it back).
+ *
+ * POSIX path only: sys_semaphore.c's Win32 path still counts and signals (it
+ * was not changed with the POSIX one and is not tested here).
+ * =========================================================================*/
+#ifndef _WIN32
+typedef struct { uint32_t sid; volatile LONG result; volatile LONG done; } t7_waiter;
+
+static unsigned __stdcall t7_wait_thread(void* p)
+{
+    t7_waiter* w = (t7_waiter*)p;
+    ppu_context ctx; ctx_init_for_thread(&ctx, alloc_tid());
+    int32_t rc = call2((int64_t(*)(ppu_context*))sys_semaphore_wait, &ctx, w->sid, (uint64_t)3000000);
+    InterlockedExchange(&w->result, rc);
+    InterlockedExchange(&w->done, 1);
+    return 0;
+}
+
+static int test7_semaphore_handoff(void)
+{
+    const char* name = "test7_semaphore_handoff";
+    LONG before = g_fail_count;
+    ppu_context ctx; ctx_init_for_thread(&ctx, alloc_tid());
+    uint32_t sattr = make_sema_attr(SYS_SYNC_FIFO);
+
+    for (int trial = 0; trial < 50; trial++) {
+        uint32_t sid_addr = guest_alloc(4);
+        int32_t rc = call4((int64_t(*)(ppu_context*))sys_semaphore_create, &ctx, sid_addr, sattr, 0, 0x7FFFFFFF);
+        if (rc != CELL_OK) { fail(name, "create rc=0x%08X", (unsigned)rc); return 1; }
+        uint32_t sid = read_be32(sid_addr);
+
+        t7_waiter w = { sid, -1, 0 };
+        HANDLE th = (HANDLE)_beginthreadex(NULL, 0, t7_wait_thread, &w, 0, NULL);
+        /* wait until the thread is parked on the semaphore */
+        for (int i = 0; i < 2000; i++) {
+            if (g_sys_semaphores[(sid - 1) & 0xFFu].waiters > 0) break;
+            Sleep(1);
+        }
+        if (g_sys_semaphores[(sid - 1) & 0xFFu].waiters != 1) fail(name, "trial %d: waiter never parked", trial);
+
+        /* destroy with a waiter: EBUSY */
+        rc = call1((int64_t(*)(ppu_context*))sys_semaphore_destroy, &ctx, sid);
+        if (rc != (int32_t)CELL_EBUSY) fail(name, "trial %d: destroy with a waiter rc=0x%08X (want EBUSY)", trial, (unsigned)rc);
+
+        /* post once, then immediately try to take it from this thread */
+        rc = call2((int64_t(*)(ppu_context*))sys_semaphore_post, &ctx, sid, 1);
+        if (rc != CELL_OK) fail(name, "trial %d: post rc=0x%08X", trial, (unsigned)rc);
+        rc = call2((int64_t(*)(ppu_context*))sys_semaphore_wait, &ctx, sid, (uint64_t)20000 /* 20ms */);
+        if (rc != (int32_t)CELL_ETIMEDOUT)
+            fail(name, "trial %d: the late wait took the posted token (rc=0x%08X)", trial, (unsigned)rc);
+
+        WaitForSingleObject(th, INFINITE);
+        CloseHandle(th);
+        if (w.result != CELL_OK) fail(name, "trial %d: the waiter got rc=0x%08X (want OK)", trial, (unsigned)w.result);
+
+        rc = call1((int64_t(*)(ppu_context*))sys_semaphore_destroy, &ctx, sid);
+        if (rc != CELL_OK) fail(name, "trial %d: destroy rc=0x%08X", trial, (unsigned)rc);
+
+        /* the destroyed id is not handed straight back */
+        uint32_t sid2_addr = guest_alloc(4);
+        rc = call4((int64_t(*)(ppu_context*))sys_semaphore_create, &ctx, sid2_addr, sattr, 0, 1);
+        if (rc != CELL_OK) { fail(name, "re-create rc=0x%08X", (unsigned)rc); return 1; }
+        uint32_t sid2 = read_be32(sid2_addr);
+        if (sid2 == sid) fail(name, "trial %d: destroyed id %u came straight back", trial, (unsigned)sid);
+        rc = call2((int64_t(*)(ppu_context*))sys_semaphore_post, &ctx, sid, 1);
+        if (rc != (int32_t)CELL_ESRCH) fail(name, "trial %d: post on a destroyed id rc=0x%08X (want ESRCH)", trial, (unsigned)rc);
+        call1((int64_t(*)(ppu_context*))sys_semaphore_destroy, &ctx, sid2);
+    }
+
+    int ok = (g_fail_count == before);
+    printf("[%s] -> %s\n", name, ok ? "PASS" : "FAIL");
+    return ok ? 0 : 1;
+}
