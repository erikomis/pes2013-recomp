+/* A controller was just opened. */
+static void pad_dsx_open(SDL_GameController* gc)
+{
+    if (SDL_GameControllerGetType(gc) == SDL_CONTROLLER_TYPE_PS5) {
+        pad_ds5_effect(gc, 1, -1);
