+    "        float3 d = T(p, int2(-1, 0)), e = c,              f = T(p, int2(1, 0));\n"
+    "        float3 g = T(p, int2(-1, 1)), h = T(p, int2(0, 1)), i = T(p, int2(1, 1));\n"
+    "        float3 mn = min(min(min(d, e), min(f, b)), h);\n"
+    "        float3 mn2 = min(mn, min(min(a, cc), min(g, i)));\n"
+    "        mn += mn2;\n"
+    "        float3 mx = max(max(max(d, e), max(f, b)), h);\n"
+    "        float3 mx2 = max(mx, max(max(a, cc), max(g, i)));\n"
+    "        mx += mx2;\n"
+    "        float3 amp = sqrt(saturate(min(mn, 2.0 - mx) / max(mx, 1e-5)));\n"
+    "        float peak = -1.0 / lerp(8.0, 5.0, pc[1].x);\n"
+    "        float3 w = amp * peak;\n"
+    "        c = saturate(((b + d + f + h) * w + e) / (1.0 + 4.0 * w));\n"
+    "    }\n"
+    "    if (pc[1].y != 0.0) {\n"
+    "        float l = dot(c, float3(0.2126, 0.7152, 0.0722));\n"
+    "        float sat = max(c.r, max(c.g, c.b)) - min(c.r, min(c.g, c.b));\n"
+    "        c = saturate(lerp(l.xxx, c, 1.0 + pc[1].y * (1.0 - sat)));\n"
+    "    }\n"
+    "    c = saturate((c - 0.5) * pc[1].z + 0.5);\n"
+    "    return float4(c, ce.a);\n"
+    "}\n";
+
+static int vk_pp_ieq(const char* a, const char* b)
+{
+    for (; *a && *b; a++, b++) {
+        char x = *a, y = *b;
+        if (x >= 'A' && x <= 'Z') x = (char)(x - 'A' + 'a');
+        if (y >= 'A' && y <= 'Z') y = (char)(y - 'A' + 'a');
+        if (x != y) return 0;
+    }
+    return *a == *b;
+}
+
+static void vk_pp_read(void)
+{
+    if (s_post.read) return;
+    s_post.read = 1;
+    const char* e = getenv("PS3_AA");
+    s_post.aa = e && vk_pp_ieq(e, "smaa") ? 1 : 0;
+    if (e && *e && !s_post.aa && !vk_pp_ieq(e, "off") && strcmp(e, "0"))
+        VK_LOG("PS3_AA=%s: only smaa on Vulkan; off\n", e);
+    e = getenv("PS3_SHARPEN");
+    { const double v = e && *e ? atof(e) : 0.0; s_post.sharpen = !(v > 0.0) ? 0.0f : v > 1.0 ? 1.0f : (float)v; }
+    e = getenv("PS3_VIBRANCE");
+    { const double v = e && *e ? atof(e) : 0.0; s_post.vib = !(v == v) ? 0.0f : v < -1.0 ? -1.0f : v > 1.0 ? 1.0f : (float)v; }
+    e = getenv("PS3_CONTRAST");
+    { const double v = e && *e ? atof(e) : 1.0; s_post.con = !(v > 0.0) ? 1.0f : v < 0.5 ? 0.5f : v > 1.5 ? 1.5f : (float)v; }
+    if (s_post.aa || s_post.sharpen > 0.0f || s_post.vib != 0.0f || s_post.con != 1.0f)
+        VK_LOG("picture: AA %s, sharpen %.2f, vibrance %.2f, contrast %.2f\n",
+               s_post.aa ? "SMAA" : "off", (double)s_post.sharpen, (double)s_post.vib, (double)s_post.con);
+}
+
+/* A colour target of exactly w x h (not scaled by PS3_RES_SCALE). */
+static u32 vk_pp_target(void* user, u32 w, u32 h, const void* seed, u32 seed_row_bytes)
+{
+    const int rs = s_rs_on;
+    s_rs_on = 0;
+    const u32 t = vk_eng_color_target_create(user, RSX_BE_FMT_R8G8B8A8, w, h, seed, seed_row_bytes);
+    if (t) { s_eobj[t].lw = w; s_eobj[t].lh = h; }
+    s_rs_on = rs;
+    return t;
+}
+
+static u32 vk_pp_pipeline(void* user, const char* ps)
+{
+    const rsx_be_render_state state = { .color_mask = 0x01010101u };
+    const rsx_vertex_layout_plan layout = { .mask = 1, .stride = 16, .count = 1 };
+    return vk_eng_pipeline_create(user, s_pp_vs, ps, &state, &layout, 16, RSX_BE_FMT_R8G8B8A8, 1);
+}
+
+static char* vk_pp_smaa_text(const char* tail)
+{
+    const size_t n = sizeof VK_PP_SMAA_HEAD + sizeof kSmaaSrc + strlen(tail) + 4;
+    char* t = (char*)malloc(n);
+    if (t) snprintf(t, n, "%s%s\n%s", VK_PP_SMAA_HEAD, kSmaaSrc, tail);
+    return t;
+}
+
+static int vk_pp_build(void* user)
+{
+    if (s_post.failed) return -1;
+    if (s_post.aa && !s_post.pipe_edge) {
+        char* a = vk_pp_smaa_text(s_pp_edge_tail);
+        char* b = vk_pp_smaa_text(s_pp_weight_tail);
+        char* c = vk_pp_smaa_text(s_pp_blend_tail);
+        if (a && b && c) {
+            s_post.pipe_edge = vk_pp_pipeline(user, a);
+            s_post.pipe_weight = vk_pp_pipeline(user, b);
+            s_post.pipe_blend = vk_pp_pipeline(user, c);
+        }
+        free(a); free(b); free(c);
+        if (!s_post.pipe_edge || !s_post.pipe_weight || !s_post.pipe_blend) {
+            VK_LOG("picture: the SMAA passes could not be built; SMAA off\n");
+            s_post.aa = 0;
+        } else {
+            /* SMAA's look-up tables, as colour targets (sampled without a crossbar). */
+            u8* rgba = (u8*)calloc((size_t)AREATEX_WIDTH * AREATEX_HEIGHT, 4);
+            if (rgba) {
+                for (u32 i = 0; i < AREATEX_WIDTH * AREATEX_HEIGHT; i++) {
+                    rgba[i * 4 + 0] = areaTexBytes[i * 2 + 0];
+                    rgba[i * 4 + 1] = areaTexBytes[i * 2 + 1];
+                }
+                s_post.area = vk_pp_target(user, AREATEX_WIDTH, AREATEX_HEIGHT, rgba, AREATEX_WIDTH * 4);
+                free(rgba);
+            }
+            rgba = (u8*)calloc((size_t)SEARCHTEX_WIDTH * SEARCHTEX_HEIGHT, 4);
+            if (rgba) {
+                for (u32 i = 0; i < SEARCHTEX_WIDTH * SEARCHTEX_HEIGHT; i++)
+                    rgba[i * 4 + 0] = rgba[i * 4 + 1] = rgba[i * 4 + 2] = rgba[i * 4 + 3] = searchTexBytes[i];
+                s_post.search = vk_pp_target(user, SEARCHTEX_WIDTH, SEARCHTEX_HEIGHT, rgba, SEARCHTEX_WIDTH * 4);
+                free(rgba);
+            }
+            if (!s_post.area || !s_post.search) { VK_LOG("picture: no SMAA tables; SMAA off\n"); s_post.aa = 0; }
+        }
+    }
+    const int want_final = s_post.sharpen > 0.0f || s_post.vib != 0.0f || s_post.con != 1.0f;
+    if (want_final && !s_post.pipe_final) {
+        s_post.pipe_final = vk_pp_pipeline(user, s_pp_final);
+        if (!s_post.pipe_final) VK_LOG("picture: the sharpen/colour pass could not be built; off\n");
+    }
+    if (!s_post.aa && !s_post.pipe_final) { s_post.failed = 1; return -1; }
+    return 0;
+}
+
+static int vk_pp_targets(void* user, u32 w, u32 h)
+{
+    if (s_post.w == w && s_post.h == h) return 0;
+    u32* const all[] = { &s_post.edges, &s_post.weights, &s_post.aa_out, &s_post.fin };
+    for (u32 i = 0; i < 4; i++) if (*all[i]) { vk_eng_release(user, *all[i]); *all[i] = 0; }
+    s_post.w = s_post.h = 0;
+    if (s_post.aa && (!(s_post.edges = vk_pp_target(user, w, h, NULL, 0)) ||
+                    !(s_post.weights = vk_pp_target(user, w, h, NULL, 0)) ||
+                    !(s_post.aa_out = vk_pp_target(user, w, h, NULL, 0)))) return -1;
+    if (s_post.pipe_final && !(s_post.fin = vk_pp_target(user, w, h, NULL, 0))) return -1;
+    s_post.w = w; s_post.h = h;
+    return 0;
+}
+
+/* One full-screen pass into `out` at its own size. */
+static void vk_pp_pass(void* user, u32 pipe, u32 out, const u32 tex[RSX_BE_MAX_TEXTURES], const float pc[16])
+{
+    static const float tri[][4] = { {-1, -1, 0, 1}, {3, -1, 0, 1}, {-1, 3, 0, 1} };
+    rsx_be_sampler_desc smp[RSX_BE_MAX_TEXTURES];
+    memset(smp, 0, sizeof smp);
+    u32 mask = 0;
+    for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++) {
+        smp[u].wrap_s = smp[u].wrap_t = smp[u].wrap_r = 3;   /* clamp to edge */
+        smp[u].min_linear = smp[u].mag_linear = (u != 1);    /* unit 1: SMAA's point sampler */
+        smp[u].max_lod = 0.0f;
+        if (tex[u]) mask |= 1u << u;
+    }
+    /* SMAA samples its edges and weights through unit 0's linear sampler as
+     * well as point-sampled; unit 1 is bound to the same image as 0 when free. */
+    u32 t[RSX_BE_MAX_TEXTURES];
+    memcpy(t, tex, sizeof t);
+    vk_eng_bind_targets(user, &out, 1, 0);
+    vk_eng_bind_pipeline(user, pipe);
+    vk_eng_bind_textures(user, t, smp, mask);
+    vk_eng_bind_ps_constants(user, pc, 64);
+    const vk_eng_obj* o = vk_eng_get(out, VK_ENG_COLOR);
+    s_e2.vp[0] = 0.0f; s_e2.vp[1] = 0.0f; s_e2.vp[2] = (float)o->w; s_e2.vp[3] = (float)o->h; s_e2.have_vp = 1;
+    s_e2.sc[0] = 0; s_e2.sc[1] = 0; s_e2.sc[2] = o->w; s_e2.sc[3] = o->h; s_e2.have_sc = 1;
+    vk_eng_draw(user, RSX_TOPOLOGY_TRIANGLES, tri, 3, 16, NULL, 0);
+}
